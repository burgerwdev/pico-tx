+// Transmit schemes (all modulation happens in tx_modulator.c)
+// ---------------------------------------------------------------------------
+
+static const char *const tx_scheme_names[] = {
+    "fm", "tone", "fsk", "ook", "cw", "chirp", "psk",
+};
+
+// pico_tx.set_mode("fm"|"tone"|"fsk"|"ook"|"cw"|"chirp"|"psk"|0..6)
+static mp_obj_t mod_pico_tx_set_mode(mp_obj_t mode_obj) {
+    uint8_t scheme;
+    if (mp_obj_is_int(mode_obj)) {
+        mp_int_t m = mp_obj_get_int(mode_obj);
+        if (m < 0 || m > TX_MOD_PSK) {
+            mp_raise_ValueError(MP_ERROR_TEXT("mode 0..6"));
+        }
+        scheme = (uint8_t)m;
+    } else {
+        const char *name = mp_obj_str_get_str(mode_obj);
+        scheme = 0xFF;
+        for (uint8_t i = 0; i <= TX_MOD_PSK; i++) {
+            if (strcmp(name, tx_scheme_names[i]) == 0) {
+                scheme = i;
+                break;
+            }
+        }
+        if (scheme == 0xFF) {
+            mp_raise_ValueError(MP_ERROR_TEXT("unknown mode"));
+        }
+    }
+    tx_modulator_set_scheme(scheme);
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_mode_obj, mod_pico_tx_set_mode);
+
