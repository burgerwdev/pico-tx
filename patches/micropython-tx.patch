new file mode 100644
index 0000000..792dd8a
--- /dev/null
+++ b/ports/rp2/tx/tx_modulator.h
@@ -0,0 +1,215 @@
+/*
+ * tx_modulator.h
+ *
+ * FM modulator engine for the MicroPython RP2040 FM transmitter.
+ *
+ * This connects three real-time pieces:
+ *   - the USB Audio (UAC1) receive path: PCM frames arrive from the host in
+ *     the TinyUSB audio driver callback (soft IRQ / tud_task context);
+ *   - a fixed 48 kHz sample clock (PWM slice wrap interrupt) that pops one
+ *     mono sample per tick;
+ *   - the pico-fractional-pll library, whose pico_fractional_pll_set_freq_u32()
+ *     is called once per sample to frequency-modulate the RF carrier.
+ *
+ * The MicroPython-visible control surface (init/enable/deviation/audio...) is
+ * exposed by modpico_tx.c on top of this file.
+ */
+
+#ifndef MICROPY_INCLUDED_RP2_TX_TX_MODULATOR_H
+#define MICROPY_INCLUDED_RP2_TX_TX_MODULATOR_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// Reset all modulator state (call before pico_fractional_pll_init()).
+void tx_modulator_init(void);
+
+// Set the RF carrier and the full-scale deviation.
+// carrier_hz:   centre frequency in Hz (e.g. 87900000).
+// deviation_hz: a full-scale int16 sample (+/-32767) shifts the carrier by
+//               +/-deviation_hz.
+void tx_modulator_set_carrier(uint32_t carrier_hz, uint32_t deviation_hz);
+
+// Change only the full-scale deviation (carrier stays as set before).
+void tx_modulator_set_deviation(uint32_t deviation_hz);
+
+// Change the modulation centre frequency (carrier).  The PLL output clamps to
+// its configured range if the requested centre + deviation goes outside it.
+void tx_modulator_set_carrier_hz(uint32_t carrier_hz);
+
+// Getters for the current FM parameters.
+uint32_t tx_modulator_carrier_hz(void);
+uint32_t tx_modulator_deviation_hz(void);
+
+// ---------------------------------------------------------------------------
+// Transmit schemes.  ALL modulation is done in the 48 kHz sample ISR; the
+// MicroPython layer only selects the scheme, configures it and feeds data.
+//   FM    - USB audio -> frequency modulation (the original behaviour)
+//   TONE  - internal DDS sine(s) -> FM (test tone / CTCSS / DTMF)
+//   FSK   - symbol FIFO -> carrier +/- shift (2-FSK)
+//   OOK   - symbol FIFO -> RF on/off (on-off keying / ASK envelope)
+//   CW    - manual key line -> RF on/off (Morse; timing driven from Python)
+//   CHIRP - linear frequency ramp (FMCW / sweep), optional repeat
+//   PSK   - symbol FIFO -> phase (BPSK/QPSK), constant envelope
+// ---------------------------------------------------------------------------
+typedef enum {
+    TX_MOD_FM = 0,
+    TX_MOD_TONE,
+    TX_MOD_FSK,
+    TX_MOD_OOK,
+    TX_MOD_CW,
+    TX_MOD_CHIRP,
+    TX_MOD_PSK,
+} tx_scheme_t;
+
+// Select the active scheme (TX_MOD_*).  Does not start/stop the ISR; call
+// tx_modulator_start()/stop().  Switching scheme resets the per-scheme state.
+void tx_modulator_set_scheme(uint8_t scheme);
+uint8_t tx_modulator_scheme(void);
+
+// Start/stop the 48 kHz sample-clock interrupt (the modulation engine).
+// FM also requires the host to have selected a non-zero alternate setting.
+void tx_modulator_start(void);
+void tx_modulator_stop(void);
+
+// Start/stop the 48 kHz sample-clock interrupt that drives the modulation.
+// Audio only flows while the host has selected a non-zero alternate setting.
+void tx_modulator_audio_start(void);
+void tx_modulator_audio_stop(void);
+
+// Internal tone generator (TX_MOD_TONE): up to two simultaneous sine tones at
+// `level` (0..32767, full-scale = full deviation).  hz2 = 0 disables the
+// second tone.  tone_stop() silences them (carrier parks on fc).
+void tx_modulator_tone(uint32_t hz, uint32_t hz2, uint16_t level);
+void tx_modulator_tone_stop(void);
+
+// Symbol rate / shape for FSK, OOK and PSK.  baud is the symbol rate; sps is
+// derived as 48000/baud (rounded, min 1).
+//   FSK: shift_hz is the +/- carrier shift of a '1' (a '0' is -shift_hz).
+//   OOK: symbol bit 0 -> RF off, non-zero -> RF on (shift_hz ignored).
+//   PSK: order is 2 (BPSK) or 4 (QPSK); shift_hz ignored.
+void tx_modulator_set_symbol_rate(uint32_t baud);
+void tx_modulator_fsk_config(uint32_t baud, uint32_t shift_hz);
+void tx_modulator_ook_config(uint32_t baud);
+void tx_modulator_psk_config(uint32_t baud, uint8_t order);
+
+// Push symbols into the shared symbol FIFO (FSK/OOK/PSK).  Returns the number
+// accepted (the FIFO holds 256 symbols; the rest must be retried later).
+uint16_t tx_modulator_write_symbols(const uint8_t *syms, uint16_t n);
+
+// Number of symbols still queued for transmission.
+uint32_t tx_modulator_symbol_pending(void);
+
+// Manual key line for TX_MOD_CW: true = carrier on, false = RF off.
+void tx_modulator_set_key(bool on);
+bool tx_modulator_key(void);
+
+// Linear chirp (TX_MOD_CHIRP): sweep f0 -> f1 over duration_ms, then hold f0
+// for gap_ms before repeating (if repeat).  Frequencies are absolute Hz and
+// must lie inside the PLL window set by init(carrier +/- deviation).
+void tx_modulator_chirp(uint32_t f0_hz, uint32_t f1_hz, uint32_t duration_ms,
+    uint32_t gap_ms, bool repeat);
+void tx_modulator_chirp_stop(void);
+
+// True while the host is streaming audio (AS interface alternate setting != 0).
+bool tx_modulator_audio_active(void);
+
+// Set the gain applied to incoming samples (0..32767 -> mute..unity).
+void tx_modulator_set_volume(uint16_t volume);
+uint16_t tx_modulator_get_volume(void);
+
+// Mute the incoming audio stream.
+void tx_modulator_set_mute(bool mute);
+bool tx_modulator_get_mute(void);
+
+// Enable/disable the audio quality processing chain:
+// 15 kHz band-limit + 50/75 us FM pre-emphasis + soft-knee limiter
+// (enabled by default).
+void tx_modulator_set_preemphasis(bool enable);
+bool tx_modulator_get_preemphasis(void);
+
+// Select the pre-emphasis time constant (50 or 75 us).  Applies from the
+// next sample; the default is 75 us (matches US/EU broadcast practice).
+void tx_modulator_set_preemphasis_us(uint16_t us);
+uint16_t tx_modulator_get_preemphasis_us(void);
+
+// Narrowband silence handling: when `gate` is true the RF output is keyed off
+// on silence (no stream / mute / audio off) and keyed back on when audio
+// flows; when false (broadcast FM) the unmodulated carrier parks on fc.
+void tx_modulator_set_silence_gate(bool gate);
+bool tx_modulator_silence_gate(void);
+bool tx_modulator_rf_gated(void);
+
+// Narrowband voice-band chain: 300 Hz high-pass + 3 kHz low-pass (handheld
+// radio bands).  Broadcast FM keeps the 15 kHz band-limit.
+void tx_modulator_set_nfm_audio(bool nfm);
+bool tx_modulator_nfm_audio(void);
+
+// Weak-sample mute threshold in raw sample amplitude (0..32767).
+// 0 disables it; samples below the threshold are zeroed in the RX path so
+// faint background noise is not modulated (the carrier then parks on fc).
+void tx_modulator_set_squelch(uint16_t threshold);
+uint16_t tx_modulator_get_squelch(void);
+
+// Number of limiter clips since the last init (diagnostics / level meter).
+uint32_t tx_modulator_clips(void);
+
+// Copy up to max of the most recent transmitted mono samples (chronological
+// order, oldest first).  Returns the number of samples copied.
+uint16_t tx_modulator_get_samples(int16_t *buf, uint16_t max);
+
+// Ring buffer fill level in percent (0..100).  Useful to watch clock drift.
+uint8_t tx_modulator_ring_level(void);
+
+// The last frequency (Hz) written to the PLL by the 48 kHz sample ISR.
+uint32_t tx_modulator_last_freq(void);
+
+// Onboard LED (GPIO25 by default) mode:
+//   0 = off
+//   1 = always on
+//   2 = on while the host is streaming audio
+//   3 = audio-level meter (brightness follows the transmitted signal)
+void tx_modulator_set_led_mode(uint8_t mode);
+uint8_t tx_modulator_get_led_mode(void);
+
+// Change the GPIO used for the LED (any 0..29).  Re-configures the PWM on
+// the new pin.  Default 25 (Pico onboard LED).
+void tx_modulator_set_led_pin(uint8_t pin);
+uint8_t tx_modulator_get_led_pin(void);
+
+// True when a terminal/serial program actually has the CDC port open
+// (enumerated AND DTR asserted).
+bool tx_modulator_cdc_connected(void);
+
+// Diagnostics counters (for tuning/verification):
+//   isr_ticks  - how many times the 48kHz sample ISR has fired
+//   rx_frames  - how many mono frames the USB RX path has enqueued
+// 48000 ticks/s and 48000 frames/s while streaming is the expected balance.
+void tx_modulator_get_counters(uint32_t *isr_ticks, uint32_t *rx_frames);
+
+// Ring-buffer health counters (host-clock vs PWM-clock drift):
+//   underflows - empty-ring ticks while the host is streaming; the last
+//                sample is repeated (hold-last), so these are inaudible
+//                drift events rather than clicks; the counter is the trace
+//   drops      - host samples discarded because the ring was full
+// Both are zero at a perfect clock match and grow at the crystal offset
+// (about samples_per_second = 48000 * ppm * 1e-6).
+void tx_modulator_get_ring_stats(uint32_t *underflows, uint32_t *drops);
+
+// Read the actual PWM slice registers used for the 48kHz sample clock.
+void tx_modulator_pwm_info(uint32_t *top, uint32_t *div, uint32_t *csr);
+
+// Read the free-running PWM counter of the sample-clock slice.  Sampling it
+// 1s apart gives the true wrap rate (delta/1000 Hz) independent of the ISR.
+uint32_t tx_modulator_pwm_ctr(void);
+
+// Measure the sample-ISR execution cost in microseconds (calls the handler
+// 1000 times with interrupts off).  Should be a few microseconds; if it is
+// tens of microseconds, the per-sample path is too slow.
+uint32_t tx_modulator_isr_cost_us(void);
+
+// Convenience getters for the tone generator state.
+uint32_t tx_modulator_tone_hz(void);
+bool tx_modulator_tone_on(void);
+
+#endif // MICROPY_INCLUDED_RP2_TX_TX_MODULATOR_H
