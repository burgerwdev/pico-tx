diff --git a/ports/rp2/tx/pico_fractional_pll.c b/ports/rp2/tx/pico_fractional_pll.c
new file mode 100644
index 0000000..e479210
--- /dev/null
+++ b/ports/rp2/tx/pico_fractional_pll.c
@@ -0,0 +1,554 @@
+/*
+  pico_fractional_pll.c
+  Pseudo Fractional PLL for RP2040
+  Copyright 2024 by Kazuhisa "Kazu." Terasaki
+  https://github.com/kaduhi/pico-fractional-pll
+*/
+
+#include "pico_fractional_pll.h"
+
+#include "pico/multicore.h"
+
+#include "hardware/clocks.h"
+#include "hardware/structs/pll.h"
+#include "hardware/structs/clocks.h"
+#include "hardware/structs/scb.h"
+#include "hardware/exception.h"
+#include "hardware/structs/systick.h"
+
+#define ALARM_NUM   2
+#define ALARM_IRQ   TIMER_IRQ_2
+
+// Core1 PDM-loop stack size in words.  Kept in plain .bss (not the SDK's
+// .stack1/SCRATCH_X section, which the MicroPython RP2040 linker leaves at 0).
+#define PICO_CORE1_STACK_SIZE_WORDS (512) // 2KB
+
+extern uint32_t ram_vector_table[48];
+uint32_t __attribute__((aligned(256))) ram_vector_table2[48];
+
+static const uint32_t xo_freq = 12000000;
+
+// PLL VCO frequency range has to be 750MHz - 1600MHz
+static const uint32_t vco_freq_max = 1600000000;  // 133
+static const uint32_t vco_freq_min = 750000000;   // 63
+
+static const uint32_t foutpostdiv_freq_max = 150000000; //133000000;
+
+// PLL reference divider.  1 = default (library-tested, 12MHz PFD).
+// 2 = experimental: halves the feedback-divider step (12MHz -> 6MHz per
+// fbdiv LSB), which halves the PDM dithering amplitude seen at the output
+// and cuts the residual frequency ripple received by narrowband (12.5/25kHz
+// channel) FM radios by ~6dB.  Legal per the RP2040 datasheet (PFD >= 5MHz,
+// FBDIV stays in 16..320), but PLL lock/jitter should be re-verified.
+// Read once by pico_fractional_pll_init() -> set before init().
+static volatile uint32_t s_pll_refdiv = 1;
+
+// PDM dithering rate in Hz.  Default 1MHz (47-cycle systick reload at 48MHz
+// clk_sys) is the library-tested value.  2MHz (23 cycles) dithers faster than
+// the PLL loop filter can follow, so the loop averages it more strongly and
+// the residual ripple drops (~6-12dB, loop-slope dependent).  3/4MHz reloads
+// (15/11 cycles) are close to the M0+ systick exception latency (~21 cycles)
+// and will be rate-limited / jittery - hardware test required.
+// Read once by core1_main() at launch -> set before init().
+static volatile uint32_t s_pdm_rate_hz = 1000000;
+
+static pico_fractional_pll_instance_t pico_fractional_pll_instance;
+
+enum core1_state_t {
+  core1_state_not_started = 0,
+  core1_state_initialized,
+  core1_state_running,
+  core1_state_stopping = 8, // do not change this, used in assembly code
+  core1_state_stopped,
+};
+// this needs to be uint32_t, because accessing in assembly code
+static volatile uint32_t s_core1_state = core1_state_not_started;
+
+
+extern void __unhandled_user_irq(void);
+
+static bool is_div_possible(uint32_t vco_freq, uint32_t div, uint32_t *o_postdiv1, uint32_t *o_postdiv2, uint32_t *o_clkdiv);
+static bool calculate_pll_divider(pico_fractional_pll_instance_t *instance, uint32_t freq_range_min, uint32_t freq_range_max);
+static void launch_core1(void);
+
+
+// public functions
+
+int pico_fractional_pll_set_refdiv(uint32_t refdiv)
+{
+  if (refdiv != 1 && refdiv != 2) {
+    return -1;
+  }
+  s_pll_refdiv = refdiv;
+  return 0;
+}
+
+uint32_t pico_fractional_pll_refdiv(void)
+{
+  return s_pll_refdiv;
+}
+
+int pico_fractional_pll_set_pdm_rate(uint32_t rate_hz)
+{
+  if (rate_hz < 1000000 || rate_hz > 4000000) {
+    return -1;
+  }
+  s_pdm_rate_hz = rate_hz;
+  return 0;
+}
+
+uint32_t pico_fractional_pll_pdm_rate(void)
+{
+  return s_pdm_rate_hz;
+}
+
+int pico_fractional_pll_init(PLL pll, uint gpio, uint32_t freq_range_min, uint32_t freq_range_max, enum gpio_drive_strength drive_strength, enum gpio_slew_rate slew_rate)
+{
+  if (s_core1_state != core1_state_not_started) {
+    return 0;
+  }
+
+  pico_fractional_pll_instance.pll = pll;
+  pico_fractional_pll_instance.gpio = gpio;
+  pico_fractional_pll_instance.drive_strength = drive_strength;
+  pico_fractional_pll_instance.slew_rate = slew_rate;
+
+  if (calculate_pll_divider(&pico_fractional_pll_instance, freq_range_min, freq_range_max) == false) {
+    return -1;
+  }
+
+  // Precompute 2^64 / freq_delta as a Q32.32 reciprocal so the per-sample
+  // setter can map freq -> acc_increment with one 64-bit multiply instead of
+  // a slow 64-bit division (the 48kHz ISR runs on the FPU-less M0+).
+  {
+    uint64_t d = pico_fractional_pll_instance.freq_delta;
+    uint64_t hi = 0x100000000ULL / d;          // floor(2^32 / d)
+    uint64_t rem = 0x100000000ULL % d;         // 2^32 mod d
+    pico_fractional_pll_instance.acc_per_freq_q64 = (hi << 32) | ((rem << 32) / d);
+  }
+
+  uint32_t ref = xo_freq / s_pll_refdiv;
+
+  uint gpclk;
+  uint src;
+  if (gpio == 21) {
+    gpclk = clk_gpout0;
+    src = (pll == pll_sys) ? CLOCKS_CLK_GPOUT0_CTRL_AUXSRC_VALUE_CLKSRC_PLL_SYS : CLOCKS_CLK_GPOUT0_CTRL_AUXSRC_VALUE_CLKSRC_PLL_USB;
+  }
+  else if (gpio == 23) {
+    gpclk = clk_gpout1;
+    src = (pll == pll_sys) ? CLOCKS_CLK_GPOUT1_CTRL_AUXSRC_VALUE_CLKSRC_PLL_SYS : CLOCKS_CLK_GPOUT1_CTRL_AUXSRC_VALUE_CLKSRC_PLL_USB;
+  }
+  else if (gpio == 24) {
+    gpclk = clk_gpout2;
+    src = (pll == pll_sys) ? CLOCKS_CLK_GPOUT2_CTRL_AUXSRC_VALUE_CLKSRC_PLL_SYS : CLOCKS_CLK_GPOUT2_CTRL_AUXSRC_VALUE_CLKSRC_PLL_USB;
+  }
+  else if (gpio == 25) {
+    gpclk = clk_gpout3;
+    src = (pll == pll_sys) ? CLOCKS_CLK_GPOUT3_CTRL_AUXSRC_VALUE_CLKSRC_PLL_SYS : CLOCKS_CLK_GPOUT3_CTRL_AUXSRC_VALUE_CLKSRC_PLL_USB;
+  }
+  else {
+    return -2;
+  }
+  pico_fractional_pll_instance.gpclk = gpclk;
+  pico_fractional_pll_instance.srcclk = src;
+
+  // initially the output is disabled
+  pico_fractional_pll_enable_output(false);
+
+  pico_fractional_pll_instance.acc_increment = 0x80000000;
+  pll_init(pll, s_pll_refdiv, (ref * pico_fractional_pll_instance.fbdiv_low), pico_fractional_pll_instance.postdiv1, pico_fractional_pll_instance.postdiv2);
+
+  launch_core1();
+
+  s_core1_state = core1_state_running;
+
+  return 0;
+}
+
+int pico_fractional_pll_deinit(void)
+{
+  if (s_core1_state == core1_state_not_started) {
+    return 0;
+  }
+
+  pico_fractional_pll_enable_output(false);
+
+  pll_deinit(pico_fractional_pll_instance.pll);
+
+  s_core1_state = core1_state_stopping;
+  while (s_core1_state == core1_state_stopping) { }
+  multicore_reset_core1();
+
+  s_core1_state = core1_state_not_started;
+
+  return 0;
+}
+
+void pico_fractional_pll_enable_output(bool enable)
+{
+  if (s_core1_state == core1_state_not_started) {
+    return;
+  }
+
+  if (enable) {
+    clock_gpio_init_int_frac(pico_fractional_pll_instance.gpio, pico_fractional_pll_instance.srcclk, pico_fractional_pll_instance.clkdiv, 0);
+    if (pico_fractional_pll_instance.clkdiv & 1) {
+      // enable duty cycle correction for odd divisor
+      clocks_hw->clk[pico_fractional_pll_instance.gpclk].ctrl |= CLOCKS_CLK_GPOUT0_CTRL_DC50_BITS;
+    }
+    else {
+      clocks_hw->clk[pico_fractional_pll_instance.gpclk].ctrl &= ~CLOCKS_CLK_GPOUT0_CTRL_DC50_BITS;
+    }
+    gpio_set_drive_strength(pico_fractional_pll_instance.gpio, pico_fractional_pll_instance.drive_strength);
+    gpio_set_slew_rate(pico_fractional_pll_instance.gpio, pico_fractional_pll_instance.slew_rate);
+  }
+  else {
+    gpio_set_function(pico_fractional_pll_instance.gpio, GPIO_FUNC_NULL);
+    gpio_set_dir(pico_fractional_pll_instance.gpio, GPIO_IN);
+    gpio_set_pulls(pico_fractional_pll_instance.gpio, false, false);
+  }
+}
+
+void pico_fractional_pll_set_drive_strength(enum gpio_drive_strength drive_strength)
+{
+  pico_fractional_pll_instance.drive_strength = drive_strength;
+  if (s_core1_state == core1_state_not_started) {
+    return;
+  }
+  gpio_set_drive_strength(pico_fractional_pll_instance.gpio, pico_fractional_pll_instance.drive_strength);
+}
+
+void pico_fractional_pll_set_slew_rate(enum gpio_slew_rate slew_rate)
+{
+  pico_fractional_pll_instance.slew_rate = slew_rate;
+  if (s_core1_state == core1_state_not_started) {
+    return;
+  }
+  gpio_set_slew_rate(pico_fractional_pll_instance.gpio, pico_fractional_pll_instance.slew_rate);
+}
+
+void pico_fractional_pll_set_freq_u32(uint32_t freq)
+{
+  if (freq < pico_fractional_pll_instance.freq_low) {
+    pico_fractional_pll_instance.acc_increment = 0;
+  }
+  else if (freq >= pico_fractional_pll_instance.freq_high) {
+    pico_fractional_pll_instance.acc_increment = 0xffffffff;
+  }
+  else {
+    // acc = (freq - freq_low) * 2^32 / freq_delta, using the precomputed
+    // Q32.32 reciprocal: one 64-bit multiply + shift (fast, no division).
+    pico_fractional_pll_instance.acc_increment =
+      (uint32_t)(((uint64_t)(freq - pico_fractional_pll_instance.freq_low) *
+                  pico_fractional_pll_instance.acc_per_freq_q64) >> 32);
+  }
+}
+
+void pico_fractional_pll_set_freq_28p4(uint32_t freq_28p4)
+{
+  uint32_t freq = freq_28p4 >> 4;
+  if (freq < pico_fractional_pll_instance.freq_low) {
+    pico_fractional_pll_instance.acc_increment = 0;
+  }
+  else if (freq >= pico_fractional_pll_instance.freq_high) {
+    pico_fractional_pll_instance.acc_increment = 0xffffffff;
+  }
+  else {
+    pico_fractional_pll_instance.acc_increment = (uint32_t)(((uint64_t)(freq_28p4 - (pico_fractional_pll_instance.freq_low << 4)) << (32 - 4)) / pico_fractional_pll_instance.freq_delta);
+  }
+}
+
+void pico_fractional_pll_set_freq_d(double freq)
+{
+  if (freq < pico_fractional_pll_instance.freq_low) {
+    pico_fractional_pll_instance.acc_increment = 0;
+  }
+  else if (freq >= pico_fractional_pll_instance.freq_high) {
+    pico_fractional_pll_instance.acc_increment = 0xffffffff;
+  }
+  else {
+    pico_fractional_pll_instance.acc_increment = (uint32_t)((freq - (double)pico_fractional_pll_instance.freq_low) * (double)0x100000000 / (double)pico_fractional_pll_instance.freq_delta);
+  }
+}
+
+void pico_fractional_pll_set_freq_f(float freq)
+{
+  if (freq < pico_fractional_pll_instance.freq_low) {
+    pico_fractional_pll_instance.acc_increment = 0;
+  }
+  else if (freq >= pico_fractional_pll_instance.freq_high) {
+    pico_fractional_pll_instance.acc_increment = 0xffffffff;
+  }
+  else {
+    pico_fractional_pll_instance.acc_increment = (uint32_t)((freq - (float)pico_fractional_pll_instance.freq_low) * (float)0x100000000 / (float)pico_fractional_pll_instance.freq_delta);
+  }
+}
+
+void pico_fractional_pll_get_freq_range(uint32_t *freq_low, uint32_t *freq_high)
+{
+  *freq_low = pico_fractional_pll_instance.freq_low;
+  *freq_high = pico_fractional_pll_instance.freq_high;
+}
+
+
+// static functions
+
+static const uint32_t possible_postdiv_values[][2] = {
+    {1, 1}, // 1
+    {2, 1}, // 2
+    {3, 1}, // 3
+    {4, 1}, // 4
+    {5, 1}, // 5
+    {6, 1}, // 6
+    {7, 1}, // 7
+    {4, 2}, // 8
+    {3, 3}, // 9
+    {5, 2}, // 10
+    {6, 2}, // 12
+    {7, 2}, // 14
+    {5, 3}, // 15
+    {4, 4}, // 16
+    {6, 3}, // 18
+    {5, 4}, // 20
+    {7, 3}, // 21
+    {6, 4}, // 24
+    {5, 5}, // 25
+    {7, 4}, // 28
+    {6, 5}, // 30
+    {7, 5}, // 35
+    {6, 6}, // 36
+    {7, 6}, // 42
+    {7, 7}, // 49
+};
+
+static bool is_div_possible(uint32_t vco_freq, uint32_t div, uint32_t *o_postdiv1, uint32_t *o_postdiv2, uint32_t *o_clkdiv) {
+    for (int i = (sizeof(possible_postdiv_values) / 2 / sizeof(possible_postdiv_values[0][0])) - 1; i >= 0; i--) {
+        uint32_t postdiv1 = possible_postdiv_values[i][0];
+        uint32_t postdiv2 = possible_postdiv_values[i][1];
+        uint32_t postdiv = postdiv1 * postdiv2;
+        uint32_t clkdiv = div / postdiv;
+        if ((div % postdiv) == 0 && (vco_freq / postdiv) <= foutpostdiv_freq_max) {
+            *o_postdiv1 = postdiv1;
+            *o_postdiv2 = postdiv2;
+            *o_clkdiv = clkdiv;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool calculate_pll_divider(pico_fractional_pll_instance_t *instance, uint32_t freq_range_min, uint32_t freq_range_max)
+{
+  uint32_t ref = xo_freq / s_pll_refdiv;
+  uint32_t fbdiv_max = vco_freq_max / ref;
+  uint32_t fbdiv_min = (vco_freq_min + (ref - 1)) / ref;
+
+  for (int pass = 0; pass < 2; pass++) {
+    for (uint32_t fbdiv_high = fbdiv_max; fbdiv_high > fbdiv_min; fbdiv_high--) {
+      uint32_t fbdiv_low = fbdiv_high - 1;
+
+      uint32_t vco_freq_low = ref * fbdiv_low;
+      uint32_t vco_freq_high = ref * fbdiv_high;
+
+      uint32_t div_low = (vco_freq_low + (freq_range_min - 1)) / freq_range_min;
+      uint32_t div_high = vco_freq_high / freq_range_max;
+
+      uint32_t div_freq_low = vco_freq_low / div_low;
+      uint32_t div_freq_high = vco_freq_high / div_high;
+
+      if (div_low != div_high) {
+        // only supports single div value for entire range
+        continue;
+      }
+
+      uint32_t div = div_high;
+      uint32_t postdiv1, postdiv2, clkdiv;
+      if (is_div_possible(vco_freq_high, div, &postdiv1, &postdiv2, &clkdiv) == false) {
+        // couldn't find any valid combination of postdiv1 and postdiv2
+        continue;
+      }
+
+      div_freq_low = vco_freq_low / div;
+      div_freq_high = vco_freq_high / div;
+
+      if ((vco_freq_low % div) != 0 || (vco_freq_high % div) != 0) {
+        // div_freq_low or div_freq_high is not integer number
+        // in pass 0, continue find other possible combinations
+        // in pass 1, just accept them
+        if (pass == 0) {
+          continue;
+        }
+      }
+
+      // found the right combination
+      instance->freq_low = div_freq_low;    //TODO: handle the not integer cases
+      instance->freq_high = div_freq_high;  //TODO: handle the not integer cases
+      instance->fbdiv_low = fbdiv_low;
+      instance->fbdiv_high = fbdiv_high;
+      instance->div = div;
+      instance->postdiv1 = postdiv1;
+      instance->postdiv2 = postdiv2;
+      instance->clkdiv = clkdiv;
+      instance->freq_delta = div_freq_high - div_freq_low;
+      instance->acc_increment = 0;
+      return true;
+    }
+  }
+
+  return false;
+}
+
+void core1_systick_callback(void);
+
+static inline void __not_in_flash_func(fractional_pll_core_logic)(void)
+{
+  // r0: temp
+  // r1: #0
+  // r2: pico_fractional_pll_instance
+  // r3: s_core1_state
+  // r4: acc
+  // r5: acc_increment
+  // r6: fbdiv_low
+  // r7: pll
+  __asm(" \n\
+    push {r0,r1,r2,r3,r4,r5,r6,r7}                  \n\
+    mov r1, #0                                      \n\
+    ldr r2, =(pico_fractional_pll_instance)         \n\
+    ldr r3, =(s_core1_state)                        \n\
+    mov r4, #0                                      \n\
+    ldr r5, [r2, #4]  // acc_increment              \n\
+    ldr r6, [r2, #8]  // fbdiv_low                  \n\
+    ldr r7, [r2, #0]  // pll                        \n\
+    b loop_1                                        \n\
+                                                    \n\
+    core1_systick_callback:                         \n\
+                                                    \n\
+    // thank you for reading my source code.        \n\
+    // seems like you are really trying to          \n\
+    // understand how my code works...              \n\
+    // and now you are going to be surprised.       \n\
+                                                    \n\
+    // below 4 lines are the real 'CORE LOGIC' of   \n\
+    // my Pico Fractional PLL implemenation:        \n\
+                                                    \n\
+    add r4, r5                                      \n\
+    adc r1, r6                                      \n\
+    str r1, [r7, #8]  // pll->fbdiv_int             \n\
+    bx  lr                                          \n\
+                                                    \n\
+    // yes, that's it!! very very simple.           \n\
+    // maybe you still don't get why this 4 lines   \n\
+    // of code does the job. that's totally fine.   \n\
+                                                    \n\
+    // but if you are able to see all my stories    \n\
+    // behind above 4 lines of code, hey, you're    \n\
+    // now my friend. let's talk!                   \n\
+    // yes, i already know what your background is, \n\
+    // since you're able to understand my code.     \n\
+    //                   Kazuhisa 'Kazu.' Terasaki  \n\
+                                                    \n\
+    loop_1:                                         \n\
+    wfi                                             \n\
+    ldr r5, [r2, #4]  // acc_increment              \n\
+    ldr r0, [r3]                                    \n\
+    cmp r0, #8  // core1_state_stopping             \n\
+    bne loop_1                                      \n\
+                                                    \n\
+    // disable systick                              \n\
+    ldr r2, =(0xe000e010)                           \n\
+    str r1, [r2, #0]  // systick_hw->csr            \n\
+    pop {r0,r1,r2,r3,r4,r5,r6,r7}                   \n\
+  ");
+}
+
+static void __not_in_flash_func(timer_alarm_callback)(void)
+{
+  timer_hw->intr = (1u << ALARM_NUM);
+}
+
+static void __not_in_flash_func(core1_main)(void)
+{
+  // disable all interrupts
+  for (int i = 0; i < 48; i++) {
+    if (i >= VTABLE_FIRST_IRQ) {
+      irq_set_enabled(i - VTABLE_FIRST_IRQ, false);
+    }
+  }
+
+  // set the code1 dedicated vector table
+  scb_hw->vtor = (uintptr_t)ram_vector_table2;
+
+  // since the SYS_PLL is running on 12MHz XO clock and Core1 is on 48MHz sys_clk,
+  // the timing of writing to the pll->fbdiv_int may not in sync with the XO clock.
+  // this is bad, so we use the timer alarm (on XO clock) to sync.
+
+  // setup an alarm
+  hw_clear_bits(&timer_hw->armed, 1u << ALARM_NUM);
+  hw_clear_bits(&timer_hw->intr, 1u << ALARM_NUM);
+  hw_set_bits(&timer_hw->inte, 1u << ALARM_NUM);
+  irq_set_exclusive_handler(ALARM_IRQ, timer_alarm_callback);
+  irq_set_enabled(ALARM_IRQ, true);
+  timer_hw->alarm[ALARM_NUM] = timer_hw->timerawl + 2;
+
+  // DO NOT CHANGE ANYTHING BELOW!!
+  // if change, the number of "nop"s needs to be re-adjusted for precise timing
+  __asm(" \n\
+    wfi   \n\
+    nop   \n\
+    nop   \n\
+    nop   \n\
+  ");
+
+  hw_clear_bits(&timer_hw->armed, 1u << ALARM_NUM);
+  hw_clear_bits(&timer_hw->intr, 1u << ALARM_NUM);
+  timer_hw->inte &= ~(1u << ALARM_NUM);
+  irq_set_enabled(ALARM_IRQ, false);
+
+  // setup exception handler then start core1 systick counter
+  systick_hw->csr &= ~M0PLUS_SYST_CSR_ENABLE_BITS;
+  exception_set_exclusive_handler(SYSTICK_EXCEPTION, (exception_handler_t)((uint32_t)core1_systick_callback + 1));
+  systick_hw->csr |= M0PLUS_SYST_CSR_CLKSOURCE_BITS | M0PLUS_SYST_CSR_TICKINT_BITS;
+  systick_hw->cvr = 0;  // document says: A write of any value clears the field to 0
+  systick_hw->rvr = (48000000 / s_pdm_rate_hz) - 1; // 48MHz/1MHz-1 = 47 -> 1.0usec
+  systick_hw->csr |= M0PLUS_SYST_CSR_ENABLE_BITS;
+  // DO NOT CHANGE ANYTHING ABOVE!!
+
+  s_core1_state = core1_state_initialized;
+
+  fractional_pll_core_logic();
+
+  systick_hw->csr &= ~M0PLUS_SYST_CSR_ENABLE_BITS;
+  s_core1_state = core1_state_stopped;
+
+  // wait for core1 reset
+  for (;;) {
+    __asm("wfi");
+  }
+}
+
+static void launch_core1(void)
+{
+  static bool init_done = false;
+  if (!init_done) {
+    init_done = true;
+    // copy the vector table
+    __builtin_memcpy(ram_vector_table2, ram_vector_table, sizeof(ram_vector_table2));
+    // clear the table
+    for (int i = 0; i < 48; i++) {
+      if (i >= VTABLE_FIRST_IRQ) {
+        ram_vector_table2[i] = (uint32_t)__unhandled_user_irq;
+      }
+    }
+  }
+
+  s_core1_state = core1_state_not_started;
+
+  // Use our own stack: the SDK's multicore_launch_core1() requires the static
+  // .stack1 section (SCRATCH_X), which the MicroPython RP2040 linker script
+  // leaves at 0 bytes.
+  static uint32_t core1_stack[PICO_CORE1_STACK_SIZE_WORDS];
+  multicore_launch_core1_with_stack(core1_main, core1_stack, sizeof(core1_stack));
+
+  while (s_core1_state == core1_state_not_started) { }
+}
diff --git a/ports/rp2/tx/pico_fractional_pll.h b/ports/rp2/tx/pico_fractional_pll.h
new file mode 100644
index 0000000..a58875f
--- /dev/null
+++ b/ports/rp2/tx/pico_fractional_pll.h
@@ -0,0 +1,75 @@
+/*
+  pico_fractional_pll.h
+  Pseudo Fractional PLL for RP2040
+  Copyright 2024 by Kazuhisa "Kazu." Terasaki
+  https://github.com/kaduhi/pico-fractional-pll
+*/
+
+#ifndef _PICO_FRACTIONAL_PLL_H
+#define _PICO_FRACTIONAL_PLL_H
+
+#include "pico/stdlib.h"
+#include "hardware/pll.h"
+
+typedef struct pico_fractional_pll_instance_t {
+  // do not change this block, referred from the assembly code
+  PLL pll;
+  uint32_t acc_increment;
+  uint32_t fbdiv_low;
+
+  uint gpio;
+  uint gpclk;
+  uint srcclk;
+  enum gpio_drive_strength drive_strength;
+  enum gpio_slew_rate slew_rate;
+  uint32_t freq_low;
+  uint32_t freq_high;
+  uint32_t fbdiv_high;
+  uint32_t div;
+  uint32_t postdiv1;
+  uint32_t postdiv2;
+  uint32_t clkdiv;
+  uint32_t freq_delta;
+  // Fixed-point reciprocal 2^64 / freq_delta (Q32.32), precomputed at init so
+  // the per-sample frequency setter only needs a 64-bit multiply (no slow
+  // 64-bit division in the 48 kHz ISR on the FPU-less M0+).
+  uint64_t acc_per_freq_q64;
+} pico_fractional_pll_instance_t;
+
+int pico_fractional_pll_init(PLL pll, uint gpio, uint32_t freq_range_min, uint32_t freq_range_max, enum gpio_drive_strength drive_strength, enum gpio_slew_rate slew_rate);
+
+// Experimental narrowband-noise controls.  Set BEFORE init() (both are read
+// once during init / core1 launch).
+//  - refdiv: PLL reference divider 1 (default) or 2.  REFDIV=2 halves the
+//    feedback-divider step (12MHz -> 6MHz per fbdiv LSB), halving the PDM
+//    dither amplitude and cutting residual ripple ~6dB.
+//  - pdm rate: PDM dither rate in Hz, 1MHz (default) .. 4MHz.  A faster rate
+//    is averaged more strongly by the PLL loop filter (less narrowband
+//    ripple); >2MHz is close to the M0+ systick latency limit - test first.
+int pico_fractional_pll_set_refdiv(uint32_t refdiv);
+uint32_t pico_fractional_pll_refdiv(void);
+int pico_fractional_pll_set_pdm_rate(uint32_t rate_hz);
+uint32_t pico_fractional_pll_pdm_rate(void);
+
+int pico_fractional_pll_deinit(void);
+
+void pico_fractional_pll_enable_output(bool enable);
+
+void pico_fractional_pll_set_drive_strength(enum gpio_drive_strength drive_strength);
+
+void pico_fractional_pll_set_slew_rate(enum gpio_slew_rate slew_rate);
+
+void pico_fractional_pll_set_freq_u32(uint32_t freq);
+
+// fixed point: 28bit integer + 4bit fraction
+void pico_fractional_pll_set_freq_28p4(uint32_t freq_28p4);
+
+void pico_fractional_pll_set_freq_d(double freq);
+
+void pico_fractional_pll_set_freq_f(float freq);
+
+// Return the actual output frequency range [Hz] of the configured PLL.
+// May be wider than the requested range (it covers the whole divider step).
+void pico_fractional_pll_get_freq_range(uint32_t *freq_low, uint32_t *freq_high);
+
+#endif // _PICO_FRACTIONAL_PLL_H
diff --git a/ports/rp2/tx/tx_modulator.c b/ports/rp2/tx/tx_modulator.c
new file mode 100644
index 0000000..c875121
--- /dev/null
+++ b/ports/rp2/tx/tx_modulator.c
@@ -0,0 +1,1334 @@
+/*
+ * tx_modulator.c
+ *
+ * FM modulator engine for the MicroPython RP2040 FM transmitter.
+ *
+ * Real-time data path (no Python involvement):
+ *
+ *   host (48kHz stereo 16-bit PCM)
+ *     -> TinyUSB audio driver RX callback (tud_task / soft IRQ context)
+ *     -> mono mix + volume/mute applied here
+ *     -> SPSC ring buffer
+ *     -> PWM slice wrap interrupt at exactly 48kHz (clk_sys 48MHz / 1000)
+ *     -> pico_fractional_pll_set_freq_u32(carrier + sample * deviation / 32768)
+ *     -> core1 PDM loop drives PLL_SYS feedback divider, RF on the GPOUT pin
+ *
+ * The PWM sample clock is used (instead of the microsecond timer) because it
+ * produces an exact, jitter-free 48kHz tick: 48MHz clk_sys / 1000 = 48kHz.
+ */
+
+#include "py/mpconfig.h"
+
+#include "tx_modulator.h"
+
+#include "hardware/gpio.h"
+#include "hardware/irq.h"
+#include "hardware/pwm.h"
+#include "hardware/timer.h"
+
+#include "pico_fractional_pll.h"
+
+// 256-entry Q14 sine table for the internal DDS tone generator.
+#include "tx_sine_table.h"
+
+// Include TinyUSB before checking CFG_TUD_AUDIO: tusb.h (via tusb_config.h)
+// is what defines CFG_TUD_AUDIO in the first place.
+#include "tusb.h"
+
+#if MICROPY_HW_TX
+
+// ---------------------------------------------------------------------------
+// SPSC ring buffer of mono int16 samples.
+// Producer: tud_audio_rx_done_isr() (tud_task context, core 0).
+// Consumer: PWM wrap ISR (core 0).  Same core, so volatile head/tail is safe.
+// ---------------------------------------------------------------------------
+
+#define TX_RING_SIZE  4096
+#define TX_RING_MASK  (TX_RING_SIZE - 1)
+
+static volatile uint16_t s_ring_head;
+static volatile uint16_t s_ring_tail;
+static int16_t s_ring[TX_RING_SIZE];
+
+// Last sample sent to the PLL (held between ticks).
+static volatile int16_t s_cur_sample;
+
+// FM parameters.
+static volatile uint32_t s_carrier_hz;
+static volatile uint32_t s_deviation_hz;
+
+// Volume (0..32767) and mute, applied to incoming samples.
+static volatile uint16_t s_volume;
+static volatile bool s_mute;
+
+// True while the host has selected a non-zero AS alternate setting.
+static volatile bool s_audio_active;
+
+// True while the USB-audio -> FM routing is enabled (audio on).
+// Reported as "muted" to the host via UAC1 GET_CUR when off, so Windows
+// shows the mute state for `audio off` too.
+static volatile bool s_audio_route_on;
+
+// Second-order band-limit section: Chebyshev type I, 0.2 dB passband ripple,
+// Q15 coefficients, direct form II transposed.  Designed and verified by
+// tools/design_filters.py (Q15 quantisation error < 0.05 dB; peak internal
+// state at full scale ~3.3e4, far below int32).
+//   wideband:   order 4, fc = 15 kHz   -> two second-order sections
+//   narrowband: order 2, fc = 3.4 kHz  -> one section
+typedef struct {
+    int32_t b0, b1, b2, a1, a2;   // Q15, a0 = 1
+    int32_t s1, s2;
+} tx_biquad_t;
+
+static tx_biquad_t s_bq_w0 = { 20188, 40377, 20188, 25338, 22648, 0, 0 };
+static tx_biquad_t s_bq_w1 = {  9684, 19368,  9684,  1777,  4191, 0, 0 };
+static tx_biquad_t s_bq_n0 = {  2540,  5080,  2540, -37018, 14411, 0, 0 };
+
+static inline void tx_biquad_reset(tx_biquad_t *q) {
+    q->s1 = 0;
+    q->s2 = 0;
+}
+
+// Audio quality processing state (see tx_audio_process below).
+static volatile bool s_preemphasis_enabled;
+static volatile uint16_t s_preemph_us;  // pre-emphasis time constant: 50/75/300 us
+static int32_t s_pre_g_q10;             // pre-emphasis G = tau*fs (Q10)
+static int32_t s_pre_x1;                // pre-emphasis differentiator x[n-1]
+static int32_t s_dcb_xprev;             // DC blocker (2 Hz high-pass) state
+static int32_t s_dcb_yprev;
+static int32_t s_hp_xprev;              // NFM 300 Hz high-pass state
+static int32_t s_hp_yprev;
+static volatile bool s_nfm_audio;       // narrowband voice-band chain (300Hz HP + 3kHz LP)
+static volatile uint16_t s_squelch_thr; // weak-sample mute threshold (0 = off)
+static volatile uint32_t s_clips;       // limiter clip counter (since boot)
+
+// Diagnostics / LED state.
+static volatile uint32_t s_last_freq;   // last frequency written to the PLL
+static volatile uint8_t s_led_mode;     // 0 off, 1 always-on, 2 stream, 3 VU
+static volatile int32_t s_led_peak;     // smoothed |sample| for the VU meter
+static bool s_led_pwm_ready;
+static volatile uint32_t s_isr_ticks;   // 48kHz ISR invocation counter
+static volatile uint32_t s_rx_frames;   // mono frames enqueued by the RX path
+
+static void tx_led_configure(void);
+static void tx_led_apply(void);
+
+// PWM slice used for the 48 kHz sample clock.
+// Reserved: do not use machine.PWM on GPIOs mapped to this slice (GP28/GP29).
+#define TX_PWM_SLICE  7
+
+// LED output GPIO.  Default 25 (onboard LED on the Pico); can be changed at
+// runtime (tx_modulator_set_led_pin) for boards with a different LED pin
+// (e.g. RP2040-Zero uses a WS2812 on GPIO16, so a plain LED needs a custom
+// pin).  Any GPIO can drive a plain LED via PWM.
+#define TX_LED_PIN    25
+#define TX_LED_WRAP   255
+
+static volatile uint8_t s_led_pin = TX_LED_PIN;
+
+// ---------------------------------------------------------------------------
+// Audio quality processing constants (all fixed-point int32; no FPU).
+// Defined here (before tx_modulator_init) so the init code can reference them.
+// ---------------------------------------------------------------------------
+
+#define TX_HP300_A_Q15  (31509)  // a = exp(-2*pi*300/48000)        (300Hz HP)
+#define TX_DCB_A_Q15    (9)      // 2 Hz DC blocker: a = 2*pi*2/48000
+#define TX_LIM_SOFT     (26214)  // soft-knee entry, 80% of full scale
+
+// Standard FM pre-emphasis H(f) = |1 + j*2*pi*f*tau|, implemented as the
+// first difference y = x + G*(x - x[n-1]) with G = tau*fs (Q10).  This is the
+// exact curve the receiver's de-emphasis inverts (the old code used a fixed
+// +14 dB shelf, which produced a +8.6 dB midrange hump and -6.3 dB at 15 kHz).
+#define TX_PRE_50_G_Q10   (2458)   //  50 us -> tau*fs =  2.4
+#define TX_PRE_75_G_Q10   (3686)   //  75 us -> tau*fs =  3.6
+#define TX_PRE_300_G_Q10  (14746)  // 300 us -> tau*fs = 14.4
+
+// The band-limit is applied whether or not pre-emphasis is enabled; the
+// coefficients live next to the tx_biquad_t definition above.
+
+// One biquad step: y = H(z)*x with H = (b0 + b1 z^-1 + b2 z^-2) /
+// (1 + a1 z^-1 + a2 z^-2), direct form II transposed (2 states per section).
+//
+// The input and the feedback term are bounded to int16 range so every product
+// stays safely inside int32: the largest |a1|/|b1| is 40377 (Q15) and
+// 40377 * 32767 = 1.3e9 < 2^31.  Without the bound a full-scale broadband
+// input rings the section to |y| ~ 1e5 and a1*y overflows (UB).  The section
+// only saturates when the signal is already several times full scale, i.e.
+// where the limiter below clips anyway; the unclamped y is still returned so
+// the limiter's clip counter keeps working.
+static inline int32_t tx_biquad_run(tx_biquad_t *q, int32_t x) {
+    if (x > 32767) {
+        x = 32767;
+    } else if (x < -32768) {
+        x = -32768;
+    }
+    int32_t y = ((q->b0 * x) >> 15) + q->s1;
+    int32_t yf = y;
+    if (yf > 32767) {
+        yf = 32767;
+    } else if (yf < -32768) {
+        yf = -32768;
+    }
+    q->s1 = ((q->b1 * x) >> 15) - ((q->a1 * yf) >> 15) + q->s2;
+    q->s2 = ((q->b2 * x) >> 15) - ((q->a2 * yf) >> 15);
+    return y;
+}
+
+// ---------------------------------------------------------------------------
+// 48 kHz sample clock: fires once per PWM wrap.
+// ---------------------------------------------------------------------------
+
+// Silence handling for narrowband (handheld-radio) operation:
+// - Broadcast FM (s_gate_silent == false, default): on silence the carrier
+//   parks EXACTLY on fc -> an FM radio tuned to fc outputs silence.
+// - Narrowband (s_gate_silent == true): on silence the RF output is turned
+//   OFF (PTT-style keying).  A parked unmodulated carrier is a few kHz off
+//   the radio's tuning (crystal tolerance x harmonic) and a handheld receiver
+//   hears it as a continuous tone - keying off instead lets its squelch close
+//   (silence).  Re-enabled as soon as audio flows again.
+#define TX_GATE_TICKS  (2000)   // ~42ms of silence before keying off
+static volatile bool s_gate_silent;    // key RF on silence (NFM mode)
+static volatile bool s_rf_gated;       // output currently keyed off
+static volatile uint32_t s_empty_ticks; // consecutive silent ticks
+
+// Ring-buffer health.  Both glitch sources were previously invisible: `diag`
+// only reported the ISR tick count and the RX frame count, so a drifting host
+// clock produced clicks that no counter could show.
+//
+//  s_ring_underflows - empty-ring ticks while the host IS streaming, i.e.
+//                      host-vs-PWM clock drift.  The sample is repeated
+//                      (hold-last) so the event is inaudible; the counter is
+//                      the only trace of it.
+//  s_ring_drops      - host samples dropped because the ring was full.
+static volatile uint32_t s_ring_underflows;
+static volatile uint32_t s_ring_drops;
+static uint32_t s_underflow_run;        // consecutive empty ticks (not volatile:
+                                        // only touched in the PWM ISR)
+// After this many consecutive empty ticks the host has really stopped (not
+// drifting): park the carrier on fc as before.  480 ticks = 10 ms at 48 kHz,
+// far longer than any single-tick drift event.
+#define TX_UNDERFLOW_HOLD_TICKS (480)
+
+// ---------------------------------------------------------------------------
+// General transmit schemes.  The 48 kHz ISR is the single modulation engine:
+// it dispatches on s_scheme and either writes a frequency (FM/TONE/FSK/CHIRP/
+// PSK) or keys the RF output on/off (OOK/CW).  MicroPython only configures it.
+// ---------------------------------------------------------------------------
+
+static volatile uint8_t s_scheme = TX_MOD_FM;
+
+// --- internal DDS tone generator (TX_MOD_TONE) ---
+// Phase accumulators are 32-bit: 2^32 == one full turn.  inc = hz*2^32/48000.
+static uint32_t s_dds_phase;
+static uint32_t s_dds_phase2;
+static volatile uint32_t s_tone_inc;    // 0 = tone off
+static volatile uint32_t s_tone2_inc;   // 0 = second tone off
+static volatile uint16_t s_tone_level;  // 0..32767 (= full-scale deviation)
+
+// Linear interpolation of the Q14 sine table.  phase top 8 bits index the
+// table, the next 16 bits interpolate; returns Q14 (-16384..16384).
+static inline int32_t tx_dds_sine(uint32_t phase) {
+    uint32_t idx = phase >> 24;
+    uint32_t frac = (phase >> 8) & 0xFFFF;
+    int32_t a = s_sine_q14[idx];
+    int32_t b = s_sine_q14[(idx + 1) & 0xFF];
+    return a + (((b - a) * (int32_t)frac) >> 16);
+}
+
+static inline uint32_t tx_hz_to_inc(uint32_t hz) {
+    return (uint32_t)((((uint64_t)hz) << 32) / 48000u);
+}
+
+// --- symbol FIFO + timing (FSK / OOK / PSK) ---
+#define TX_SYM_FIFO_SIZE 256
+#define TX_SYM_FIFO_MASK (TX_SYM_FIFO_SIZE - 1)
+static uint8_t s_sym_fifo[TX_SYM_FIFO_SIZE];
+static volatile uint16_t s_sym_head;      // producer (Python / control path)
+static volatile uint16_t s_sym_tail;      // consumer (ISR)
+static volatile uint32_t s_sym_baud;      // symbols/s
+static volatile uint32_t s_sps;           // samples per symbol (>= 1)
+static volatile uint32_t s_sym_countdown; // samples left in the current symbol
+static volatile uint32_t s_fsk_shift;     // FSK +/- carrier shift (Hz)
+static volatile uint8_t s_psk_order;      // 2 (BPSK) or 4 (QPSK)
+static volatile int32_t s_sym_freq;       // current FSK/PSK frequency offset
+static uint32_t s_psk_phase;              // PSK phase accumulator (2^32 = 2pi)
+static volatile bool s_rf_key;            // CW / OOK key state
+static volatile uint32_t s_sym_sent;      // symbols actually consumed
+
+// --- linear chirp (TX_MOD_CHIRP) ---
+static volatile uint32_t s_chirp_f0, s_chirp_f1;
+static volatile uint32_t s_chirp_dur;     // sweep duration in samples
+static volatile uint32_t s_chirp_period;  // dur + gap in samples
+static volatile bool s_chirp_repeat;
+static uint32_t s_chirp_tick;
+
+// Load the next symbol from the FIFO and translate it for the active scheme.
+// Runs in the ISR at the symbol rate (not per sample), so the 64-bit math for
+// the PSK phase step is affordable.
+static void __not_in_flash_func(tx_symbol_load)(void) {
+    uint16_t tail = s_sym_tail;
+    uint8_t sym = 0;
+    if (tail != s_sym_head) {
+        sym = s_sym_fifo[tail];
+        s_sym_tail = (uint16_t)((tail + 1) & TX_SYM_FIFO_MASK);
+    }
+    // An empty FIFO transmits 0 (FSK: -shift; OOK: RF off; PSK: phase 0).
+    if (s_scheme == TX_MOD_FSK) {
+        s_sym_freq = (sym & 1) ? (int32_t)s_fsk_shift : -(int32_t)s_fsk_shift;
+    } else if (s_scheme == TX_MOD_OOK) {
+        s_rf_key = (sym != 0);
+    } else if (s_scheme == TX_MOD_PSK) {
+        uint32_t order = s_psk_order ? s_psk_order : 2;
+        uint32_t sps = s_sps ? s_sps : 1;
+        // Target phase = sym/order of a turn.  The ISR takes the direct
+        // rotation to the target (freq = delta/tsym), which lands exactly on
+        // the constellation point regardless of the path taken.
+        uint32_t target = (uint32_t)(((uint64_t)(sym % order) << 32) / order);
+        int32_t delta = (int32_t)(target - s_psk_phase);
+        // freq_hz = (delta/2^32)/tsym = delta*48000/(sps*2^32)
+        s_sym_freq = (int32_t)(((int64_t)delta * 48000) / ((int64_t)sps * 4294967296LL));
+        s_psk_phase = target;
+    }
+}
+
+static void __time_critical_func(tx_pwm_wrap_handler)(void) {
+    pwm_clear_irq(TX_PWM_SLICE);
+    s_isr_ticks++;
+
+    int32_t sample = 0;
+    uint32_t freq = s_carrier_hz;
+    bool key_scheme = false;
+    bool keyed = true;
+
+    switch (s_scheme) {
+    case TX_MOD_FM: {
+        // Pop one mono sample.  Two different situations share the empty ring:
+        //  - host streaming but momentarily behind (clock drift): repeat the last
+        //    sample.  A one-sample time stretch is inaudible, whereas zeroing the
+        //    sample is a step discontinuity (a click) every drift event;
+        //  - host paused / stopped / not selected: park on 0 so the carrier sits
+        //    exactly on fc (the verified v0.22.3 behaviour) instead of drifting to
+        //    whatever the last frame happened to be.
+        uint16_t tail = s_ring_tail;
+        bool empty = (tail == s_ring_head);
+        if (!empty) {
+            s_cur_sample = s_ring[tail];
+            s_ring_tail = (uint16_t)((tail + 1) & TX_RING_MASK);
+            s_underflow_run = 0;
+        } else if (s_audio_active && s_underflow_run < TX_UNDERFLOW_HOLD_TICKS) {
+            s_underflow_run++;
+            s_ring_underflows++;
+        } else {
+            s_cur_sample = 0;
+        }
+
+        // Silence: with a zero sample (paused stream, mute, or silent frames) the
+        // carrier sits EXACTLY on fc with no modulation, so a radio tuned to fc
+        // outputs silence - the verified v0.22.3 behaviour.  No gate/sweep is
+        // needed, and an off-tune park must be avoided (a CW at the IF band edge
+        // makes the receiver's AGC/quieting cycle -> periodic plops/hiss).
+        // `sq <threshold>` instead zeroes weak samples in the RX path.
+        // Mute forces the sample to 0 here (the ring is still consumed so no
+        // backlog builds up): this bypasses any DSP transient the RX path may
+        // still be draining and silences the radio immediately.
+        sample = s_mute ? 0 : s_cur_sample;
+        // Narrowband silence gate: broadcast FM parks the unmodulated carrier on
+        // fc (an FM radio outputs silence); narrowband mode keys the RF OFF so a
+        // handheld's squelch closes instead of hearing the off-tune parked CW as
+        // a continuous tone.  Keying back on as soon as audio flows again.
+        if (s_gate_silent) {
+            bool silent = s_mute || empty;
+            if (silent) {
+                if (!s_rf_gated && (s_empty_ticks >= TX_GATE_TICKS || s_mute)) {
+                    pico_fractional_pll_enable_output(false);
+                    s_rf_gated = true;
+                }
+                s_empty_ticks++;
+            } else {
+                s_empty_ticks = 0;
+                if (s_rf_gated) {
+                    pico_fractional_pll_enable_output(true);
+                    s_rf_gated = false;
+                }
+            }
+        }
+        freq = s_carrier_hz + (uint32_t)(((int64_t)sample * (int64_t)s_deviation_hz) >> 15);
+        break;
+    }
+
+    case TX_MOD_TONE: {
+        // Internal DDS generator: one or two sine tones summed in Q14.
+        s_dds_phase += s_tone_inc;
+        int32_t tone = tx_dds_sine(s_dds_phase);
+        if (s_tone2_inc) {
+            s_dds_phase2 += s_tone2_inc;
+            tone += tx_dds_sine(s_dds_phase2);
+        }
+        int32_t t = (tone * (int32_t)s_tone_level) >> 14;
+        if (t > 32767) {
+            t = 32767;
+        } else if (t < -32768) {
+            t = -32768;
+        }
+        sample = t;
+        freq = s_carrier_hz + (uint32_t)(((int64_t)sample * (int64_t)s_deviation_hz) >> 15);
+        break;
+    }
+
+    case TX_MOD_FSK:
+    case TX_MOD_OOK:
+    case TX_MOD_PSK: {
+        if (s_sym_countdown == 0) {
+            tx_symbol_load();
+            s_sym_countdown = s_sps ? s_sps : 1;
+            s_sym_sent++;
+        }
+        s_sym_countdown--;
+        if (s_scheme == TX_MOD_OOK) {
+            key_scheme = true;
+            keyed = s_rf_key;
+        } else {
+            freq = (uint32_t)((int32_t)s_carrier_hz + s_sym_freq);
+        }
+        break;
+    }
+
+    case TX_MOD_CHIRP: {
+        uint32_t t = s_chirp_tick;
+        uint32_t dur = s_chirp_dur;
+        if (dur && t < dur) {
+            int64_t span = (int64_t)s_chirp_f1 - (int64_t)s_chirp_f0;
+            freq = (uint32_t)((int64_t)s_chirp_f0 + span * (int64_t)t / (int64_t)dur);
+        } else {
+            freq = s_chirp_f0;
+        }
+        if (s_chirp_period) {
+            s_chirp_tick++;
+            if (s_chirp_tick >= s_chirp_period) {
+                s_chirp_tick = s_chirp_repeat ? 0 : (s_chirp_period - 1);
+            }
+        }
+        break;
+    }
+
+    case TX_MOD_CW: {
+        key_scheme = true;
+        keyed = s_rf_key;
+        break;
+    }
+
+    default:
+        break;
+    }
+
+    if (key_scheme) {
+        pico_fractional_pll_set_freq_u32(s_carrier_hz);
+        pico_fractional_pll_enable_output(keyed);
+        s_last_freq = s_carrier_hz;
+        s_rf_gated = !keyed;
+    } else {
+        s_last_freq = freq;
+        pico_fractional_pll_set_freq_u32(freq);
+    }
+}
+
+static void tx_pwm_start(void) {
+    pwm_config cfg = pwm_get_default_config();
+    pwm_config_set_clkdiv(&cfg, 1.0f);
+    pwm_config_set_wrap(&cfg, 999); // 48MHz / 1000 = 48kHz
+    pwm_init(TX_PWM_SLICE, &cfg, false);
+
+    pwm_clear_irq(TX_PWM_SLICE);
+    pwm_set_irq_enabled(TX_PWM_SLICE, true);
+    irq_set_exclusive_handler(PWM_IRQ_WRAP, tx_pwm_wrap_handler);
+    // Highest NVIC priority: the 48kHz sample clock must not be starved by
+    // other interrupts (USB/pendsv).  The handler is only a few microseconds.
+    irq_set_priority(PWM_IRQ_WRAP, 0);
+    irq_set_enabled(PWM_IRQ_WRAP, true);
+
+    pwm_set_enabled(TX_PWM_SLICE, true);
+}
+
+static void tx_pwm_stop(void) {
+    irq_set_enabled(PWM_IRQ_WRAP, false);
+    pwm_set_irq_enabled(TX_PWM_SLICE, false);
+    pwm_set_enabled(TX_PWM_SLICE, false);
+}
+
+// ---------------------------------------------------------------------------
+// Public API (used by the pico_tx MicroPython module)
+// ---------------------------------------------------------------------------
+
+void tx_modulator_init(void) {
+    s_ring_head = 0;
+    s_ring_tail = 0;
+    s_cur_sample = 0;
+    s_carrier_hz = 87900000;
+    s_deviation_hz = 75000;
+    s_volume = 32767;
+    s_mute = false;
+    s_audio_active = false;
+    s_audio_route_on = false;
+    s_preemphasis_enabled = true;
+    s_preemph_us = 75;
+    s_pre_g_q10 = TX_PRE_75_G_Q10;
+    s_pre_x1 = 0;
+    tx_biquad_reset(&s_bq_w0);
+    tx_biquad_reset(&s_bq_w1);
+    tx_biquad_reset(&s_bq_n0);
+    s_dcb_xprev = 0;
+    s_dcb_yprev = 0;
+    s_hp_xprev = 0;
+    s_hp_yprev = 0;
+    s_nfm_audio = false;
+    s_squelch_thr = 0;
+    s_clips = 0;
+    s_gate_silent = false;
+    s_rf_gated = false;
+    s_empty_ticks = 0;
+    s_ring_underflows = 0;
+    s_ring_drops = 0;
+    s_underflow_run = 0;
+    s_last_freq = 0; // 0 until the 48kHz ISR has written at least once
+    s_led_mode = 0;
+    s_led_peak = 0;
+    s_led_pwm_ready = false;
+    s_led_pin = TX_LED_PIN;
+    s_isr_ticks = 0;
+    s_rx_frames = 0;
+
+    // General transmit-scheme state.
+    s_scheme = TX_MOD_FM;
+    s_dds_phase = 0;
+    s_dds_phase2 = 0;
+    s_tone_inc = 0;
+    s_tone2_inc = 0;
+    s_tone_level = 0;
+    s_sym_head = 0;
+    s_sym_tail = 0;
+    s_sym_baud = 1200;
+    s_sps = 40; // 48000/1200
+    s_sym_countdown = 1;
+    s_fsk_shift = 0;
+    s_psk_order = 2;
+    s_sym_freq = 0;
+    s_psk_phase = 0;
+    s_rf_key = false;
+    s_sym_sent = 0;
+    s_chirp_f0 = 0;
+    s_chirp_f1 = 0;
+    s_chirp_dur = 0;
+    s_chirp_period = 0;
+    s_chirp_repeat = false;
+    s_chirp_tick = 0;
+}
+
+void tx_modulator_set_carrier(uint32_t carrier_hz, uint32_t deviation_hz) {
+    s_carrier_hz = carrier_hz;
+    s_deviation_hz = deviation_hz;
+    s_cur_sample = 0;
+}
+
+void tx_modulator_set_deviation(uint32_t deviation_hz) {
+    s_deviation_hz = deviation_hz;
+}
+
+uint32_t tx_modulator_carrier_hz(void) {
+    return s_carrier_hz;
+}
+
+uint32_t tx_modulator_deviation_hz(void) {
+    return s_deviation_hz;
+}
+
+void tx_modulator_set_carrier_hz(uint32_t carrier_hz) {
+    s_carrier_hz = carrier_hz;
+}
+
+// ---------------------------------------------------------------------------
+// Scheme selection and start/stop
+// ---------------------------------------------------------------------------
+
+void tx_modulator_set_scheme(uint8_t scheme) {
+    if (scheme > TX_MOD_PSK) {
+        scheme = TX_MOD_FM;
+    }
+    if (scheme != s_scheme) {
+        // Reset per-scheme state so switching does not leak history.
+        s_dds_phase = 0;
+        s_dds_phase2 = 0;
+        s_psk_phase = 0;
+        s_sym_freq = 0;
+        s_sym_countdown = 1;
+        s_chirp_tick = 0;
+    }
+    s_scheme = scheme;
+}
+
+uint8_t tx_modulator_scheme(void) {
+    return s_scheme;
+}
+
+void tx_modulator_start(void) {
+    tx_pwm_start();
+    pico_fractional_pll_enable_output(true);
+    s_rf_gated = false;
+    if (s_scheme == TX_MOD_FM) {
+        s_audio_route_on = true;
+    }
+}
+
+void tx_modulator_stop(void) {
+    tx_pwm_stop();
+    if (s_scheme == TX_MOD_FM && !s_gate_silent) {
+        // Broadcast FM: park on the exact carrier (radio outputs silence).
+        pico_fractional_pll_set_freq_u32(s_carrier_hz);
+        s_last_freq = s_carrier_hz;
+    } else {
+        // Narrowband FM and every keyed scheme: key the RF off.
+        pico_fractional_pll_enable_output(false);
+        s_rf_gated = true;
+    }
+    s_audio_route_on = false;
+}
+
+// ---------------------------------------------------------------------------
+// Internal tone generator (TX_MOD_TONE)
+// ---------------------------------------------------------------------------
+
+void tx_modulator_tone(uint32_t hz, uint32_t hz2, uint16_t level) {
+    if (level > 32767) {
+        level = 32767;
+    }
+    s_tone_level = level;
+    s_tone_inc = hz ? tx_hz_to_inc(hz) : 0;
+    s_tone2_inc = hz2 ? tx_hz_to_inc(hz2) : 0;
+    if (!s_tone_inc && !s_tone2_inc) {
+        s_dds_phase = 0;
+        s_dds_phase2 = 0;
+    }
+    s_scheme = TX_MOD_TONE;
+}
+
+void tx_modulator_tone_stop(void) {
+    s_tone_inc = 0;
+    s_tone2_inc = 0;
+    s_tone_level = 0;
+}
+
+uint32_t tx_modulator_tone_hz(void) {
+    // Recover Hz from the increment (diagnostics only; ~exact).
+    return (uint32_t)(((uint64_t)s_tone_inc * 48000u) >> 32);
+}
+
+bool tx_modulator_tone_on(void) {
+    return s_tone_inc != 0 || s_tone2_inc != 0;
+}
+
+// ---------------------------------------------------------------------------
+// Symbol-driven schemes (FSK / OOK / PSK)
+// ---------------------------------------------------------------------------
+
+static void tx_set_baud(uint32_t baud) {
+    if (baud == 0) {
+        baud = 1200;
+    }
+    s_sym_baud = baud;
+    s_sps = (48000u + baud / 2) / baud;
+    if (s_sps == 0) {
+        s_sps = 1;
+    }
+    s_sym_countdown = 1;
+}
+
+void tx_modulator_set_symbol_rate(uint32_t baud) {
+    tx_set_baud(baud);
+}
+
+void tx_modulator_fsk_config(uint32_t baud, uint32_t shift_hz) {
+    tx_set_baud(baud);
+    s_fsk_shift = shift_hz;
+    s_scheme = TX_MOD_FSK;
+}
+
+void tx_modulator_ook_config(uint32_t baud) {
+    tx_set_baud(baud);
+    s_scheme = TX_MOD_OOK;
+}
+
+void tx_modulator_psk_config(uint32_t baud, uint8_t order) {
+    tx_set_baud(baud);
+    s_psk_order = (order == 4) ? 4 : 2;
+    s_psk_phase = 0;
+    s_scheme = TX_MOD_PSK;
+}
+
+uint16_t tx_modulator_write_symbols(const uint8_t *syms, uint16_t n) {
+    uint16_t written = 0;
+    while (written < n) {
+        uint16_t head = s_sym_head;
+        uint16_t next = (uint16_t)((head + 1) & TX_SYM_FIFO_MASK);
+        if (next == s_sym_tail) {
+            break; // FIFO full
+        }
+        s_sym_fifo[head] = syms[written++];
+        s_sym_head = next;
+    }
+    return written;
+}
+
+uint32_t tx_modulator_symbol_pending(void) {
+    return (uint32_t)((s_sym_head - s_sym_tail) & TX_SYM_FIFO_MASK);
+}
+
+void tx_modulator_set_key(bool on) {
+    s_rf_key = on;
+    if (s_scheme != TX_MOD_OOK && s_scheme != TX_MOD_CW && s_scheme != TX_MOD_FSK && s_scheme != TX_MOD_PSK) {
+        s_scheme = TX_MOD_CW;
+    }
+}
+
+bool tx_modulator_key(void) {
+    return s_rf_key;
+}
+
+// ---------------------------------------------------------------------------
+// Linear chirp (TX_MOD_CHIRP)
+// ---------------------------------------------------------------------------
+
+void tx_modulator_chirp(uint32_t f0_hz, uint32_t f1_hz, uint32_t duration_ms,
+    uint32_t gap_ms, bool repeat) {
+    uint32_t dur = (uint32_t)(((uint64_t)duration_ms * 48000u) / 1000u);
+    uint32_t gap = (uint32_t)(((uint64_t)gap_ms * 48000u) / 1000u);
+    s_chirp_f0 = f0_hz;
+    s_chirp_f1 = f1_hz;
+    s_chirp_dur = dur;
+    s_chirp_period = dur + gap;
+    s_chirp_repeat = repeat;
+    s_chirp_tick = 0;
+    s_scheme = TX_MOD_CHIRP;
+}
+
+void tx_modulator_chirp_stop(void) {
+    s_chirp_dur = 0;
+    s_chirp_period = 0;
+    s_chirp_repeat = false;
+    s_chirp_tick = 0;
+}
+
+void tx_modulator_audio_start(void) {
+    // Drop any data that accumulated in the ring while the modulator was
+    // stopped (the RX path keeps writing): starting with a clean ring avoids
+    // playing stale audio after audio off/on or mute toggles.
+    s_ring_head = 0;
+    s_ring_tail = 0;
+    s_cur_sample = 0;
+    tx_pwm_start();
+    s_audio_route_on = true;
+}
+
+void tx_modulator_audio_stop(void) {
+    tx_pwm_stop();
+    if (s_gate_silent) {
+        // Narrowband mode: key the output off - an unmodulated parked carrier
+        // would be an off-tune CW heard as a tone by a handheld radio.
+        pico_fractional_pll_enable_output(false);
+        s_rf_gated = true;
+    } else {
+        // 'audio off' should silence the radio: park the PLL on the EXACT
+        // carrier (no modulation -> a radio tuned to fc outputs silence).
+        pico_fractional_pll_set_freq_u32(s_carrier_hz);
+    }
+    s_audio_route_on = false;
+}
+
+bool tx_modulator_audio_active(void) {
+    return s_audio_active;
+}
+
+void tx_modulator_set_volume(uint16_t volume) {
+    s_volume = volume;
+}
+
+uint16_t tx_modulator_get_volume(void) {
+    return s_volume;
+}
+
+void tx_modulator_set_mute(bool mute) {
+    s_mute = mute;
+}
+
+bool tx_modulator_get_mute(void) {
+    return s_mute;
+}
+
+// ---------------------------------------------------------------------------
+// Audio quality processing (all fixed-point int32; RP2040 has no FPU).
+//
+// Chain, applied to every mono sample before it is enqueued:
+//   1. 2 Hz DC blocker              (keep the FM centre exactly on carrier)
+//   2. sq <threshold> weak-sample mute (optional: zeroes faint stream noise)
+//   3. standard pre-emphasis        (75/50/300 us first difference; the FM
+//                                    radio's de-emphasis is its exact inverse)
+//   4. band-limit                   (4th-order Chebyshev 0.5 dB at 15 kHz
+//                                    wideband, 2nd-order at 3.4 kHz narrowband)
+//   5. soft-knee limiter            (prevent over-deviation distortion)
+//
+// Silence needs no gate: a zero sample (paused, muted or sq-zeroed) parks
+// the carrier exactly on fc, so a radio tuned to fc outputs silence.
+//
+// Enabled by default (75us); can be turned off or set to 50us from
+// MicroPython with pico_tx.set_preemphasis(False) / set_preemphasis_tc().
+// ---------------------------------------------------------------------------
+
+// Process one mono sample: returns the sample to transmit.
+static int16_t tx_audio_process(int16_t x) {
+    // DC blocker (2 Hz one-pole high-pass): removes any DC offset in the
+    // incoming stream so the average frequency stays exactly on the carrier.
+    int32_t dcb = s_dcb_yprev + (x - s_dcb_xprev) - ((s_dcb_yprev * TX_DCB_A_Q15) >> 15);
+    s_dcb_xprev = x;
+    s_dcb_yprev = dcb;
+    if (dcb > 32767) {
+        dcb = 32767;
+    } else if (dcb < -32768) {
+        dcb = -32768;
+    }
+    x = (int16_t)dcb;
+
+    // NFM 300 Hz high-pass: strips hum/rumble below the voice band so they do
+    // not eat deviation budget.  One-pole: y = a*(y_prev + x - x_prev).
+    if (s_nfm_audio) {
+        int32_t hp = (int32_t)(((int64_t)TX_HP300_A_Q15 * ((int32_t)x + s_hp_yprev - s_hp_xprev)) >> 15);
+        s_hp_xprev = x;
+        s_hp_yprev = hp;
+        if (hp > 32767) {
+            hp = 32767;
+        } else if (hp < -32768) {
+            hp = -32768;
+        }
+        x = (int16_t)hp;
+    }
+
+    // sq <threshold>: zero weak samples (below the threshold) so faint
+    // background noise in the stream is not modulated; the carrier then
+    // parks on fc and the radio is silent.  0 = off (default).
+    uint16_t sq = s_squelch_thr;
+    if (sq != 0) {
+        int32_t av = x < 0 ? -x : x;
+        if (av < sq) {
+            x = 0;
+        }
+    }
+
+    // Standard pre-emphasis (75/50/300 us): first difference, y = x + G*dx.
+    // The previous sample is tracked even while disabled so toggling it back
+    // on does not inject a step transient.
+    int32_t pre_d = (int32_t)x - s_pre_x1;
+    s_pre_x1 = x;
+    if (s_preemphasis_enabled) {
+        int32_t pre = (int32_t)x + ((s_pre_g_q10 * pre_d) >> 10);
+        if (pre > 32767) {
+            pre = 32767;
+        } else if (pre < -32768) {
+            pre = -32768;
+        }
+        x = (int16_t)pre;
+    }
+
+    // Band-limit (always, also when pre-emphasis is off): 4th-order
+    // Chebyshev at 15 kHz, or 2nd-order at 3.4 kHz in narrowband voice mode.
+    // It follows the pre-emphasis so the boosted high-frequency noise is
+    // removed again before the limiter sees it.
+    int32_t y;
+    if (s_nfm_audio) {
+        y = tx_biquad_run(&s_bq_n0, x);
+    } else {
+        y = tx_biquad_run(&s_bq_w0, x);
+        y = tx_biquad_run(&s_bq_w1, y);
+    }
+
+    // Soft-knee limiter: linear below 80% full scale, 2:1 compression above,
+    // hard clip as the final safety net.
+    if (y > TX_LIM_SOFT) {
+        y = TX_LIM_SOFT + ((y - TX_LIM_SOFT) >> 1);
+    } else if (y < -TX_LIM_SOFT) {
+        y = -TX_LIM_SOFT + ((y + TX_LIM_SOFT) >> 1);
+    }
+    if (y > 32767) {
+        y = 32767;
+        s_clips++;
+    } else if (y < -32768) {
+        y = -32768;
+        s_clips++;
+    }
+
+    return (int16_t)y;
+}
+
+void tx_modulator_set_preemphasis(bool enable) {
+    if (s_preemphasis_enabled != enable) {
+        s_preemphasis_enabled = enable;
+        // The differentiator state stays valid across the toggle (it tracks
+        // x[n-1] either way), so only the flag has to change.
+    }
+}
+
+bool tx_modulator_get_preemphasis(void) {
+    return s_preemphasis_enabled;
+}
+
+// Silence-gate mode for narrowband (handheld-radio) operation.  When enabled
+// the RF output is keyed off on silence (no stream / mute / audio off) and
+// keyed back on when audio flows; broadcast FM keeps the parked-carrier
+// behaviour (an FM radio outputs silence on an unmodulated fc carrier).
+void tx_modulator_set_silence_gate(bool gate) {
+    s_gate_silent = gate;
+    if (gate) {
+        s_empty_ticks = 0;
+    }
+}
+
+bool tx_modulator_silence_gate(void) {
+    return s_gate_silent;
+}
+
+// True while the RF output is keyed off waiting for audio (narrowband mode).
+bool tx_modulator_rf_gated(void) {
+    return s_rf_gated;
+}
+
+// Narrowband voice-band chain: when enabled the audio passes a 300 Hz
+// high-pass and a 3 kHz low-pass (matching the handheld-radio channel and
+// its audio band, so deviation is not wasted on out-of-band content).
+// Broadcast FM keeps the 15 kHz band-limit.  Filter states are reset on
+// toggle (the coefficients change).
+void tx_modulator_set_nfm_audio(bool nfm) {
+    if (s_nfm_audio != nfm) {
+        s_hp_xprev = 0;
+        s_hp_yprev = 0;
+        // Reset the newly selected band-limit so its history does not leak.
+        tx_biquad_reset(&s_bq_n0);
+        tx_biquad_reset(&s_bq_w0);
+        tx_biquad_reset(&s_bq_w1);
+    }
+    s_nfm_audio = nfm;
+}
+
+bool tx_modulator_nfm_audio(void) {
+    return s_nfm_audio;
+}
+
+// Select the pre-emphasis time constant (50, 75 or 300 us).  The coefficient
+// is applied on the next sample; the filter state is reset since it depends
+// on the coefficient.  300us is the handheld-radio (voice) standard.
+void tx_modulator_set_preemphasis_us(uint16_t us) {
+    if (us == 50) {
+        s_pre_g_q10 = TX_PRE_50_G_Q10;
+        s_preemph_us = 50;
+    } else if (us == 300) {
+        s_pre_g_q10 = TX_PRE_300_G_Q10;
+        s_preemph_us = 300;
+    } else {
+        s_pre_g_q10 = TX_PRE_75_G_Q10;
+        s_preemph_us = 75;
+    }
+    // The differentiator has no coefficient-dependent state to reset.
+}
+
+uint16_t tx_modulator_get_preemphasis_us(void) {
+    return s_preemph_us;
+}
+
+// Weak-sample mute (sq) threshold in raw sample amplitude; 0 disables it.
+void tx_modulator_set_squelch(uint16_t threshold) {
+    s_squelch_thr = threshold;
+}
+
+uint16_t tx_modulator_get_squelch(void) {
+    return s_squelch_thr;
+}
+
+// Number of limiter clips since the last init (diagnostics / vbar).
+uint32_t tx_modulator_clips(void) {
+    return s_clips;
+}
+
+uint16_t tx_modulator_get_samples(int16_t *buf, uint16_t max) {
+    uint16_t head = s_ring_head;
+    uint16_t count = (uint16_t)((head - s_ring_tail) & TX_RING_MASK);
+    if (count > max) {
+        count = max;
+    }
+    // Chronological order, oldest of the snapshot first.  The consumer ISR may
+    // advance the tail concurrently (same core); a sample or two shifting is
+    // harmless for a display snapshot.
+    for (uint16_t i = 0; i < count; i++) {
+        buf[i] = s_ring[(uint16_t)((head - count + i) & TX_RING_MASK)];
+    }
+    return count;
+}
+
+uint8_t tx_modulator_ring_level(void) {
+    return (uint8_t)(((uint32_t)((s_ring_head - s_ring_tail) & TX_RING_MASK) * 100) / TX_RING_SIZE);
+}
+
+uint32_t tx_modulator_last_freq(void) {
+    return s_last_freq;
+}
+
+void tx_modulator_set_led_mode(uint8_t mode) {
+    if (mode > 3) {
+        mode = 0;
+    }
+    if (mode != 0 && !s_led_pwm_ready) {
+        tx_led_configure();
+    }
+    s_led_mode = mode;
+    if (mode != 3) {
+        s_led_peak = 0;
+    }
+    // Apply immediately so switching modes always takes effect, regardless of
+    // whether the streaming state changes afterwards.
+    tx_led_apply();
+}
+
+uint8_t tx_modulator_get_led_mode(void) {
+    return s_led_mode;
+}
+
+void tx_modulator_set_led_pin(uint8_t pin) {
+    if (pin > 29) {
+        return;
+    }
+    if (pin != s_led_pin) {
+        s_led_pin = pin;
+        if (s_led_pwm_ready) {
+            // Re-point the PWM output to the new pin's slice.
+            s_led_pwm_ready = false;
+            if (s_led_mode != 0) {
+                tx_led_configure();
+            }
+        }
+        tx_led_apply();
+    }
+}
+
+uint8_t tx_modulator_get_led_pin(void) {
+    return s_led_pin;
+}
+
+void tx_modulator_get_counters(uint32_t *isr_ticks, uint32_t *rx_frames) {
+    *isr_ticks = s_isr_ticks;
+    *rx_frames = s_rx_frames;
+}
+
+void tx_modulator_get_ring_stats(uint32_t *underflows, uint32_t *drops) {
+    *underflows = s_ring_underflows;
+    *drops = s_ring_drops;
+}
+
+void tx_modulator_pwm_info(uint32_t *top, uint32_t *div, uint32_t *csr) {
+    *top = pwm_hw->slice[TX_PWM_SLICE].top;
+    *div = pwm_hw->slice[TX_PWM_SLICE].div;
+    *csr = pwm_hw->slice[TX_PWM_SLICE].csr;
+}
+
+uint32_t tx_modulator_pwm_ctr(void) {
+    return pwm_hw->slice[TX_PWM_SLICE].ctr;
+}
+
+uint32_t tx_modulator_isr_cost_us(void) {
+    // Call the handler 1000 times with interrupts off; report average us/call.
+    uint32_t irq_state = save_and_disable_interrupts();
+    uint32_t t0 = time_us_32();
+    for (int i = 0; i < 1000; i++) {
+        tx_pwm_wrap_handler();
+    }
+    uint32_t t1 = time_us_32();
+    restore_interrupts(irq_state);
+    return (t1 - t0) / 1000;
+}
+
+// Configure the LED GPIO as an 8-bit PWM output.
+static void tx_led_configure(void) {
+    pwm_config cfg = pwm_get_default_config();
+    pwm_config_set_wrap(&cfg, TX_LED_WRAP);
+    pwm_init(pwm_gpio_to_slice_num(s_led_pin), &cfg, true);
+    gpio_set_function(s_led_pin, GPIO_FUNC_PWM);
+    s_led_pwm_ready = true;
+}
+
+// Apply the current LED mode to the PWM duty.  Called whenever the mode,
+// the streaming state or the audio level changes.
+static void tx_led_apply(void) {
+    if (!s_led_pwm_ready) {
+        return;
+    }
+    uint32_t duty;
+    switch (s_led_mode) {
+        case 1: // always on
+            duty = TX_LED_WRAP;
+            break;
+        case 2: // on while the host is streaming
+            duty = s_audio_active ? TX_LED_WRAP : 0;
+            break;
+        case 3: // audio-level meter (brightness follows the signal)
+            duty = s_led_peak >> 6; // a bit brighter than full-scale / 128
+            if (duty > TX_LED_WRAP) {
+                duty = TX_LED_WRAP;
+            }
+            break;
+        default:
+            duty = 0;
+            break;
+    }
+    pwm_set_gpio_level(s_led_pin, duty);
+}
+
+// ---------------------------------------------------------------------------
+// TinyUSB audio class callbacks (compiled when the built-in USB device
+// includes the UAC1 audio interface).
+// ---------------------------------------------------------------------------
+
+#if CFG_TUD_AUDIO
+
+// Host (re)selected the audio streaming alternate setting.
+bool tud_audio_set_itf_cb(uint8_t rhport, tusb_control_request_t const *p_request) {
+    (void)rhport;
+    uint8_t alt = tu_u16_low(p_request->wValue);
+    s_audio_active = (alt != 0);
+    if (!s_audio_active) {
+        s_led_peak = 0;
+    }
+    // Mode 2 (on while streaming) and the VU reset react to streaming changes.
+    tx_led_apply();
+    return true;
+}
+
+// One or more audio packets received from the host.  Drain the TinyUSB FIFO
+// into the ring buffer.
+bool tud_audio_rx_done_isr(uint8_t rhport, uint16_t n_bytes_received, uint8_t func_id, uint8_t ep_out, uint8_t cur_alt_setting) {
+    (void)rhport;
+    (void)n_bytes_received;
+    (void)func_id;
+    (void)ep_out;
+
+    if (cur_alt_setting == 0) {
+        return true;
+    }
+
+    // Receiving frames proves the host is streaming.  This also repairs the
+    // case where the host selected the alt setting before pico_tx.init()
+    // (tx_modulator_init resets s_audio_active) and never re-selects it, so
+    // the flag would otherwise stay false while audio actually flows.
+    s_audio_active = true;
+
+    // Muted / routing-off fast path: drain the USB FIFO and drop the frames
+    // WITHOUT running the DSP / ring / LED code.  The digital activity of
+    // decoding and filtering live audio couples switching noise into the RF
+    // path on the same die, which pollutes a parked carrier (broadcast FM
+    // silence) - so while we are intentionally silent, do the minimum work.
+    // The 48kHz ISR already forces the sample to 0 while muted, so dropping
+    // the frames here changes nothing audibly (the ring simply drains).
+    if (s_mute || !s_audio_route_on) {
+        int16_t junk[32];
+        while (tud_audio_available() >= 4) {
+            uint16_t want = tud_audio_available();
+            if (want > sizeof(junk)) {
+                want = sizeof(junk);
+            }
+            tud_audio_read(junk, want);
+        }
+        return true;
+    }
+
+    uint16_t volume = s_volume;
+    bool mute = s_mute;
+
+    while (tud_audio_available() >= 4) {
+        int16_t frame[2];
+        if (tud_audio_read(frame, sizeof(frame)) != sizeof(frame)) {
+            break;
+        }
+        // Stereo -> mono mix, then apply mute/volume.
+        int32_t mono = ((int32_t)frame[0] + (int32_t)frame[1]) >> 1;
+        if (mute) {
+            mono = 0;
+        } else {
+            mono = (mono * (int32_t)volume) >> 15;
+        }
+
+        // Band-limit + pre-emphasis + limiter.
+        int16_t out = tx_audio_process((int16_t)mono);
+
+        // Audio-level LED (mode 3): fast-attack / slow-decay level follower,
+        // so the brightness shows a readable meter instead of flickering at
+        // the audio rate.
+        if (s_led_mode == 3) {
+            int32_t a = out < 0 ? -out : out;
+            if (a > s_led_peak) {
+                s_led_peak += (a - s_led_peak) >> 2; // fast attack (~80us)
+            } else {
+                s_led_peak += (a - s_led_peak) >> 6; // slow decay (~1.3ms)
+            }
+            tx_led_apply();
+        }
+
+        uint16_t head = s_ring_head;
+        uint16_t next = (uint16_t)((head + 1) & TX_RING_MASK);
+        if (next != s_ring_tail) {
+            s_ring[head] = out;
+            s_ring_head = next;
+            s_rx_frames++;
+        } else {
+            // ring full -> drop sample (host clock slightly ahead)
+            s_ring_drops++;
+        }
+    }
+    return true;
+}
+
+// UAC1 feature-unit control selectors.
+#define TX_CS_MUTE      0x01
+#define TX_CS_VOLUME    0x02
+
+// UAC1 control request codes.
+#define TX_REQ_GET_CUR  0x81
+#define TX_REQ_GET_MIN  0x82
+#define TX_REQ_GET_MAX  0x83
+#define TX_REQ_GET_RES  0x84
+
+// Volume range in 1/256 dB units: -60dB .. 0dB, 1dB resolution.
+#define TX_VOL_MIN      (-15360)
+#define TX_VOL_MAX      (0)
+#define TX_VOL_RES      (0x0100)
+
+// -0..-60 dB as a linear gain: round(32767 * 10^(dB/20)), one entry per dB.
+// The old code mapped dB *linearly* to the gain, so requesting -30 dB produced
+// -6 dB (a +24 dB error) and the slider had only ~10 dB of usable range.
+static const uint16_t tx_vol_table[61] = {
+    32767, 29204, 26028, 23197, 20675, 18426, 16422, 14636,
+    13045, 11626, 10362,  9235,  8231,  7336,  6538,  5827,
+     5193,  4628,  4125,  3677,  3277,  2920,  2603,  2320,
+     2067,  1843,  1642,  1464,  1304,  1163,  1036,   923,
+      823,   734,   654,   583,   519,   463,   413,   368,
+      328,   292,   260,   232,   207,   184,   164,   146,
+      130,   116,   104,    92,    82,    73,    65,    58,
+       52,    46,    41,    37,    33,
+};
+
+// Convert a UAC1 volume (signed 16-bit, 1/256 dB units) to a linear gain.
+// db256 is 0..-15360 (0 dB .. -60 dB); the magnitude is split into whole dB
+// and the 1/256 dB remainder, then interpolated in the table (worst error
+// < 0.02 dB; the old linear mapping was off by +24 dB at -30 dB).
+static uint16_t tx_db256_to_gain(int16_t db256) {
+    int32_t mag = -(int32_t)db256;
+    if (mag < 0) {
+        mag = 0;
+    }
+    if (mag > -TX_VOL_MIN) {
+        mag = -TX_VOL_MIN;
+    }
+    uint32_t i = (uint32_t)mag >> 8;
+    uint32_t f = (uint32_t)mag & 0xFF;
+    if (i >= 60) {
+        return tx_vol_table[60];
+    }
+    int32_t step = (int32_t)tx_vol_table[i + 1] - (int32_t)tx_vol_table[i];
+    return (uint16_t)((int32_t)tx_vol_table[i] + ((step * (int32_t)f) >> 8));
+}
+
+// Convert a linear gain (0..32767) to a UAC1 volume (1/256 dB units).
+// Inverse of tx_db256_to_gain() by searching the (monotonic) table.
+static int16_t tx_gain_to_db256(uint16_t gain) {
+    int32_t g = gain;
+    if (g > 32767) {
+        g = 32767;
+    }
+    for (int i = 0; i < 60; i++) {
+        if (g >= (int32_t)tx_vol_table[i + 1]) {
+            int32_t span = (int32_t)tx_vol_table[i] - (int32_t)tx_vol_table[i + 1];
+            int32_t off = (int32_t)tx_vol_table[i] - g;
+            int32_t frac = (span > 0) ? ((off << 8) / span) : 0;
+            return (int16_t)(-((i << 8) + frac));
+        }
+    }
+    return (int16_t)TX_VOL_MIN;
+}
+
+// Answer a GET_* control request with a single value.
+static bool tx_control_xfer_u16(uint8_t rhport, tusb_control_request_t const *p_request, uint16_t value) {
+    return tud_control_xfer(rhport, p_request, &value, 2);
+}
+
+bool tud_audio_set_req_entity_cb(uint8_t rhport, tusb_control_request_t const *p_request, uint8_t *pBuff) {
+    (void)rhport;
+    if (p_request->bRequest != 0x01) { // SET_CUR
+        return false;
+    }
+    switch (tu_u16_high(p_request->wValue)) {
+        case TX_CS_MUTE:
+            s_mute = (pBuff[0] != 0);
+            return true;
+        case TX_CS_VOLUME: {
+            int16_t db256 = (int16_t)((uint16_t)pBuff[0] | ((uint16_t)pBuff[1] << 8));
+            s_volume = tx_db256_to_gain(db256);
+            return true;
+        }
+        default:
+            return false;
+    }
+}
+
+bool tud_audio_get_req_entity_cb(uint8_t rhport, tusb_control_request_t const *p_request) {
+    switch (tu_u16_high(p_request->wValue)) {
+        case TX_CS_MUTE: {
+            // Report muted when the console muted the stream OR the audio
+            // routing is off, so Windows shows the mute state for both.
+            uint8_t mute = (s_mute || !s_audio_route_on) ? 1 : 0;
+            switch (p_request->bRequest) {
+                case TX_REQ_GET_CUR:
+                    return tud_control_xfer(rhport, p_request, &mute, 1);
+                case TX_REQ_GET_MIN:
+                    mute = 0;
+                    return tud_control_xfer(rhport, p_request, &mute, 1);
+                case TX_REQ_GET_MAX:
+                    mute = 1;
+                    return tud_control_xfer(rhport, p_request, &mute, 1);
+                case TX_REQ_GET_RES:
+                    mute = 1;
+                    return tud_control_xfer(rhport, p_request, &mute, 1);
+                default:
+                    return false;
+            }
+        }
+        case TX_CS_VOLUME: {
+            switch (p_request->bRequest) {
+                case TX_REQ_GET_CUR:
+                    return tx_control_xfer_u16(rhport, p_request, (uint16_t)tx_gain_to_db256(s_volume));
+                case TX_REQ_GET_MIN:
+                    return tx_control_xfer_u16(rhport, p_request, (uint16_t)TX_VOL_MIN);
+                case TX_REQ_GET_MAX:
+                    return tx_control_xfer_u16(rhport, p_request, (uint16_t)TX_VOL_MAX);
+                case TX_REQ_GET_RES:
+                    return tx_control_xfer_u16(rhport, p_request, (uint16_t)TX_VOL_RES);
+                default:
+                    return false;
+            }
+        }
+        default:
+            return false;
+    }
+}
+
+// True when a terminal/serial program actually has the CDC port open
+// (enumerated AND DTR asserted).  Used by main.py to print the console
+// banner only once a terminal is connected, instead of emitting it into
+// the void at boot.
+bool tx_modulator_cdc_connected(void) {
+    return tud_cdc_connected() && (tud_cdc_get_line_state() & CDC_CONTROL_LINE_STATE_DTR);
+}
+
+#endif // CFG_TUD_AUDIO
+
+#endif // MICROPY_HW_TX
