new file mode 100644
index 0000000..dd4b3c8
--- /dev/null
+++ b/ports/rp2/boards/RPI_PICO_TX/mpconfigboard.h
@@ -0,0 +1,20 @@
+// Board and hardware specific configuration
+#define MICROPY_HW_BOARD_NAME                   "pico-tx"
+
+// Enable the pico-tx firmware:
+//  - boots with clk_sys = 48MHz from PLL_USB (leaving PLL_SYS free for RF)
+//  - enables the TinyUSB USB Audio Class (UAC1) sound-card interface
+//  - compiles the pico_tx module (pico-fractional-pll + modulation engine)
+#define MICROPY_HW_TX                           (1)
+#define MICROPY_HW_USB_AUDIO                    (1)
+
+// Unique USB identity for this firmware.  Windows caches the driver profile
+// per VID/PID: the stock MicroPython PID 0x0005 describes a CDC-only device,
+// so reusing it for a CDC+Audio composite makes Windows fail to load drivers
+// (yellow exclamation marks).  Use a distinct PID instead.
+#define MICROPY_HW_USB_VID                      (0x1209) // pid.codes (prototype)
+#define MICROPY_HW_USB_PID                      (0xFA50) // pico-tx (same as the original rp2040-fm-transmitter)
+
+// USB strings shown in the OS (Device Manager / dmesg).
+#define MICROPY_HW_USB_MANUFACTURER_STRING      "BurgerW"
+#define MICROPY_HW_USB_PRODUCT_FS_STRING        "pico-tx"
