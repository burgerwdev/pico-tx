diff --git a/ports/rp2/tx/micropython.cmake b/ports/rp2/tx/micropython.cmake
new file mode 100644
index 0000000..1cdd102
--- /dev/null
+++ b/ports/rp2/tx/micropython.cmake
@@ -0,0 +1,40 @@
+# micropython.cmake for the pico_tx user C module.
+#
+# This module is only included when the board opts in by setting
+# MICROPY_HW_TX in its mpconfigboard.cmake (see the
+# RPI_PICO_TX board).  It provides:
+#   - the pico-fractional-pll library (unmodified upstream source)
+#   - the USB audio + general modulation engine (tx_modulator.c)
+#   - the MicroPython module `pico_tx` (modpico_tx.c)
+
+# Create an INTERFACE library for our C module.
+add_library(usermod_pico_tx INTERFACE)
+
+# Add our source files to the lib.
+target_sources(usermod_pico_tx INTERFACE
+    ${CMAKE_CURRENT_LIST_DIR}/pico_fractional_pll.c
+    ${CMAKE_CURRENT_LIST_DIR}/tx_modulator.c
+    ${CMAKE_CURRENT_LIST_DIR}/modpico_tx.c
+)
+
+# Add the current directory as an include directory.
+target_include_directories(usermod_pico_tx INTERFACE
+    ${CMAKE_CURRENT_LIST_DIR}
+)
+
+# The sources compile into the firmware target; link the pico-sdk libraries
+# the module uses so their include directories and symbols are available.
+# tinyusb_device is needed for the TinyUSB headers (tusb.h / CFG_TUD_AUDIO).
+target_link_libraries(usermod_pico_tx INTERFACE
+    tinyusb_device
+    hardware_exception
+    hardware_pll
+    hardware_clocks
+    hardware_gpio
+    hardware_pwm
+    hardware_irq
+    pico_multicore
+)
+
+# Link our INTERFACE library to the usermod target.
+target_link_libraries(usermod INTERFACE usermod_pico_tx)
diff --git a/ports/rp2/tx/modpico_tx.c b/ports/rp2/tx/modpico_tx.c
new file mode 100644
index 0000000..413c8a9
--- /dev/null
+++ b/ports/rp2/tx/modpico_tx.c
@@ -0,0 +1,743 @@
+/*
+ * modpico_tx.c
+ *
+ * MicroPython module `pico_tx` - control the RP2040 FM transmitter built on
+ * the pico-fractional-pll library (https://github.com/kaduhi/pico-fractional-pll)
+ * plus the USB audio -> FM bridge (see tx_modulator.c).
+ *
+ * Usage:
+ *
+ *     import pico_tx
+ *     pico_tx.init(87_900_000, 75_000, 21)   # carrier Hz, deviation Hz, GPIO
+ *     pico_tx.enable_output(True)            # RF on (NO ANTENNA WIRE!)
+ *     pico_tx.audio(True)                    # route USB audio to the FM carrier
+ *     ...
+ *     pico_tx.deinit()
+ */
+
+#include "py/runtime.h"
+#include "py/obj.h"
+#include "py/mperrno.h"
+
+#include <string.h>
+
+#include "hardware/clocks.h"
+#include "hardware/gpio.h"
+
+#include "pico_fractional_pll.h"
+#include "tx_modulator.h"
+
+// True while the PLL has been configured successfully (set by init/deinit).
+static bool s_ready;
+
+// ---------------------------------------------------------------------------
+// pico_tx.init(carrier_hz, deviation_hz, gpio)
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_init(mp_obj_t carrier_obj, mp_obj_t deviation_obj, mp_obj_t gpio_obj) {
+    mp_int_t carrier = mp_obj_get_int(carrier_obj);
+    mp_int_t deviation = mp_obj_get_int(deviation_obj);
+    mp_int_t gpio = mp_obj_get_int(gpio_obj);
+
+    // The pico-fractional-pll library only works with clk_sys = 48MHz
+    // (sourced from PLL_USB, leaving PLL_SYS free for the RF output).
+    if (clock_get_hz(clk_sys) != 48000000) {
+        mp_raise_msg(&mp_type_RuntimeError,
+            MP_ERROR_TEXT("pico_tx requires a 48MHz system clock (use the RPI_PICO_TX board)"));
+    }
+    if (carrier <= 0 || deviation <= 0 || deviation > carrier) {
+        mp_raise_ValueError(MP_ERROR_TEXT("invalid carrier/deviation"));
+    }
+    if (gpio != 21 && gpio != 23 && gpio != 24 && gpio != 25) {
+        mp_raise_ValueError(MP_ERROR_TEXT("RF output pin must be GPIO 21, 23, 24 or 25"));
+    }
+
+    tx_modulator_init();
+
+    // The carrier +- deviation must fit within one PLL feedback-divider step;
+    // pico_fractional_pll_init() returns non-zero if the range is unusable.
+    int ret = pico_fractional_pll_init(pll_sys, (uint)gpio,
+        (uint32_t)(carrier - deviation), (uint32_t)(carrier + deviation),
+        GPIO_DRIVE_STRENGTH_12MA, GPIO_SLEW_RATE_FAST);
+    if (ret != 0) {
+        mp_raise_msg_varg(&mp_type_ValueError,
+            MP_ERROR_TEXT("frequency range %d..%d Hz not achievable by the fractional PLL"),
+            (int)(carrier - deviation), (int)(carrier + deviation));
+    }
+
+    tx_modulator_set_carrier((uint32_t)carrier, (uint32_t)deviation);
+    s_ready = true;
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_3(mod_pico_tx_init_obj, mod_pico_tx_init);
+
+// ---------------------------------------------------------------------------
+// pico_tx.enable_output(enable)
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_enable_output(mp_obj_t enable_obj) {
+    pico_fractional_pll_enable_output(mp_obj_is_true(enable_obj));
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_enable_output_obj, mod_pico_tx_enable_output);
+
+// ---------------------------------------------------------------------------
+// pico_tx.set_freq(hz)  - set the carrier directly (within the init range)
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_set_freq(mp_obj_t freq_obj) {
+    pico_fractional_pll_set_freq_u32((uint32_t)mp_obj_get_int(freq_obj));
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_freq_obj, mod_pico_tx_set_freq);
+
+// ---------------------------------------------------------------------------
+// pico_tx.set_carrier(hz) - change the modulation centre (takes effect while
+// audio routing is on; the PLL output clamps to its configured range)
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_set_carrier(mp_obj_t freq_obj) {
+    mp_int_t freq = mp_obj_get_int(freq_obj);
+    if (freq <= 0) {
+        mp_raise_ValueError(MP_ERROR_TEXT("carrier must be positive"));
+    }
+    tx_modulator_set_carrier_hz((uint32_t)freq);
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_carrier_obj, mod_pico_tx_set_carrier);
+
+// ---------------------------------------------------------------------------
+// pico_tx.set_deviation(hz)
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_set_deviation(mp_obj_t dev_obj) {
+    mp_int_t deviation = mp_obj_get_int(dev_obj);
+    if (deviation <= 0) {
+        mp_raise_ValueError(MP_ERROR_TEXT("deviation must be positive"));
+    }
+    tx_modulator_set_deviation((uint32_t)deviation);
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_deviation_obj, mod_pico_tx_set_deviation);
+
+// ---------------------------------------------------------------------------
+// pico_tx.set_refdiv(1|2) / pico_tx.refdiv()  - PLL reference divider
+// ---------------------------------------------------------------------------
+// Experimental: REFDIV=2 halves the feedback-divider step (12MHz -> 6MHz per
+// fbdiv LSB), halving the PDM dither amplitude and cutting the residual
+// ripple received by narrowband FM radios by ~6dB.  Must be set before
+// init() (takes effect on the next reinit/reboot).
+
+static mp_obj_t mod_pico_tx_set_refdiv(mp_obj_t refdiv_obj) {
+    mp_int_t refdiv = mp_obj_get_int(refdiv_obj);
+    if (pico_fractional_pll_set_refdiv((uint32_t)refdiv) != 0) {
+        mp_raise_ValueError(MP_ERROR_TEXT("refdiv must be 1 or 2"));
+    }
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_refdiv_obj, mod_pico_tx_set_refdiv);
+
+static mp_obj_t mod_pico_tx_refdiv(void) {
+    return mp_obj_new_int_from_uint(pico_fractional_pll_refdiv());
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_refdiv_obj, mod_pico_tx_refdiv);
+
+// ---------------------------------------------------------------------------
+// pico_tx.set_pdm_rate(1..4) / pico_tx.pdm_rate() - PDM dither rate in MHz
+// ---------------------------------------------------------------------------
+// Experimental: a faster dither is averaged more strongly by the PLL loop
+// filter, lowering the residual ripple for narrowband reception.  1MHz is
+// the library-tested default; 2MHz usually helps; >2MHz may be rate-limited
+// by the M0+ systick latency.  Must be set before init().
+
+static mp_obj_t mod_pico_tx_set_pdm_rate(mp_obj_t rate_obj) {
+    mp_int_t rate = mp_obj_get_int(rate_obj);
+    if (pico_fractional_pll_set_pdm_rate((uint32_t)rate * 1000000) != 0) {
+        mp_raise_ValueError(MP_ERROR_TEXT("pdm rate must be 1..4 MHz"));
+    }
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_pdm_rate_obj, mod_pico_tx_set_pdm_rate);
+
+static mp_obj_t mod_pico_tx_pdm_rate(void) {
+    return mp_obj_new_int_from_uint(pico_fractional_pll_pdm_rate() / 1000000);
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_pdm_rate_obj, mod_pico_tx_pdm_rate);
+
+// ---------------------------------------------------------------------------
+// pico_tx.audio(enable)  - route USB audio to the FM carrier
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_audio(mp_obj_t enable_obj) {
+    if (mp_obj_is_true(enable_obj)) {
+        tx_modulator_audio_start();
+    } else {
+        tx_modulator_audio_stop();
+    }
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_audio_obj, mod_pico_tx_audio);
+
+// ---------------------------------------------------------------------------
+// pico_tx.audio_active() - True while the host is streaming audio
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_audio_active(void) {
+    return mp_obj_new_bool(tx_modulator_audio_active());
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_audio_active_obj, mod_pico_tx_audio_active);
+
+// ---------------------------------------------------------------------------
+// pico_tx.set_volume(0..32767) / pico_tx.set_mute(bool)
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_set_volume(mp_obj_t vol_obj) {
+    mp_int_t vol = mp_obj_get_int(vol_obj);
+    if (vol < 0 || vol > 32767) {
+        mp_raise_ValueError(MP_ERROR_TEXT("volume must be 0..32767"));
+    }
+    tx_modulator_set_volume((uint16_t)vol);
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_volume_obj, mod_pico_tx_set_volume);
+
+static mp_obj_t mod_pico_tx_set_mute(mp_obj_t mute_obj) {
+    tx_modulator_set_mute(mp_obj_is_true(mute_obj));
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_mute_obj, mod_pico_tx_set_mute);
+
+// ---------------------------------------------------------------------------
+// pico_tx.set_preemphasis(enable) - 15kHz band-limit + pre-emphasis + limiter
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_set_preemphasis(mp_obj_t enable_obj) {
+    tx_modulator_set_preemphasis(mp_obj_is_true(enable_obj));
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_set_preemphasis_obj, mod_pico_tx_set_preemphasis);
+
+// ---------------------------------------------------------------------------
+// pico_tx.deinit()
+// ---------------------------------------------------------------------------
+
+static mp_obj_t mod_pico_tx_deinit(void) {
+    tx_modulator_audio_stop();
+    pico_fractional_pll_enable_output(false);
+    pico_fractional_pll_deinit();
+    s_ready = false;
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_deinit_obj, mod_pico_tx_deinit);
+
+// pico_tx.ready() -> True after a successful init() (and before deinit)
+static mp_obj_t mod_pico_tx_ready(void) {
+    return mp_obj_new_bool(s_ready);
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_ready_obj, mod_pico_tx_ready);
+
+// pico_tx.diag() -> (isr_ticks, rx_frames): 48kHz ISR count and enqueued
+// mono frames.  Both should rise ~48000/s while the host is streaming.
+static mp_obj_t mod_pico_tx_diag(void) {
+    uint32_t isr_ticks, rx_frames;
+    tx_modulator_get_counters(&isr_ticks, &rx_frames);
+    mp_obj_t tuple[2] = {
+        mp_obj_new_int_from_uint(isr_ticks),
+        mp_obj_new_int_from_uint(rx_frames),
+    };
+    return mp_obj_new_tuple(2, tuple);
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_diag_obj, mod_pico_tx_diag);
+
+// pico_tx.ring_stats() -> (underflows, drops): host-clock vs PWM-clock drift.
+// An underflow is an empty-ring tick while the host is streaming; the last
+// sample is repeated (hold-last) so it is inaudible, and this counter is the
+// only trace of it.  A drop is a host sample discarded because the ring was
+// full.  Both grow at ~48000 * ppm * 1e-6 per second of clock offset.
+static mp_obj_t mod_pico_tx_ring_stats(void) {
+    uint32_t underflows, drops;
+    tx_modulator_get_ring_stats(&underflows, &drops);
+    mp_obj_t tuple[2] = {
+        mp_obj_new_int_from_uint(underflows),
+        mp_obj_new_int_from_uint(drops),
+    };
+    return mp_obj_new_tuple(2, tuple);
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_ring_stats_obj, mod_pico_tx_ring_stats);
+
+// pico_tx.pwm_info() -> (top, div, csr, clk_sys_hz) of the 48kHz PWM slice.
+// Expected: TOP=999, DIV=0x0100, clk_sys=48000000.
+static mp_obj_t mod_pico_tx_pwm_info(void) {
+    uint32_t top, div, csr;
+    tx_modulator_pwm_info(&top, &div, &csr);
+    mp_obj_t tuple[4] = {
+        mp_obj_new_int_from_uint(top),
+        mp_obj_new_int_from_uint(div),
+        mp_obj_new_int_from_uint(csr),
+        mp_obj_new_int_from_uint(clock_get_hz(clk_sys)),
+    };
+    return mp_obj_new_tuple(4, tuple);
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_pwm_info_obj, mod_pico_tx_pwm_info);
+
+// pico_tx.pwm_ctr() -> free-running counter of the sample-clock PWM slice
+static mp_obj_t mod_pico_tx_pwm_ctr(void) {
+    return mp_obj_new_int_from_uint(tx_modulator_pwm_ctr());
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_pwm_ctr_obj, mod_pico_tx_pwm_ctr);
+
+// pico_tx.isr_cost() -> average microseconds per 48kHz ISR invocation
+// (measured by running the handler 1000 times with interrupts off).
+static mp_obj_t mod_pico_tx_isr_cost(void) {
+    return mp_obj_new_int_from_uint(tx_modulator_isr_cost_us());
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_isr_cost_obj, mod_pico_tx_isr_cost);
+
+// ---------------------------------------------------------------------------
+// Diagnostics / status
+// ---------------------------------------------------------------------------
+
+// pico_tx.carrier() -> Hz currently configured as the centre frequency
+static mp_obj_t mod_pico_tx_carrier(void) {
+    return mp_obj_new_int_from_uint(tx_modulator_carrier_hz());
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_carrier_obj, mod_pico_tx_carrier);
+
+// pico_tx.deviation() -> Hz full-scale deviation
+static mp_obj_t mod_pico_tx_deviation(void) {
+    return mp_obj_new_int_from_uint(tx_modulator_deviation_hz());
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(mod_pico_tx_deviation_obj, mod_pico_tx_deviation);
+
+// pico_tx.current_freq() -> last frequency (Hz) actually written to the PLL
+static mp_obj_t mod_pico_tx_current_freq(void) {
+    return mp_obj_new_int_from_uint(tx_modulator_last_freq());
+}
