+            break;
+        default:
+            mp_raise_ValueError(MP_ERROR_TEXT("power must be 2, 4, 8 or 12 mA"));
+    }
+    pico_fractional_pll_set_drive_strength(ds);
+    s_power_ma = (uint8_t)ma;
