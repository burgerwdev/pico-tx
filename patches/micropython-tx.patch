+// pico_tx.samples(n) -> bytes of the n most recent mono samples (int16 LE)
+static mp_obj_t mod_pico_tx_samples(mp_obj_t count_obj) {
+    mp_int_t n = mp_obj_get_int(count_obj);
+    if (n < 0) {
+        n = 0;
+    }
+    if (n > 512) {
+        n = 512;
+    }
+    int16_t *buf = m_new(int16_t, n);
+    uint16_t got = tx_modulator_get_samples(buf, (uint16_t)n);
+    mp_obj_t ret = mp_obj_new_bytes((const byte *)buf, (size_t)got * sizeof(int16_t));
+    m_del(int16_t, buf, n);
+    return ret;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(mod_pico_tx_samples_obj, mod_pico_tx_samples);
