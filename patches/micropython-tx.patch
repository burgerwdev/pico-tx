+    if (!mp_get_buffer(data_obj, &bufinfo, MP_BUFFER_READ)) {
+        mp_raise_TypeError(MP_ERROR_TEXT("send expects bytes"));
+    }
+    uint16_t n = bufinfo.len > 0xFFFF ? 0xFFFF : (uint16_t)bufinfo.len;
+    uint16_t written = tx_modulator_write_symbols((const uint8_t *)bufinfo.buf, n);
+    return mp_obj_new_int_from_uint(written);
